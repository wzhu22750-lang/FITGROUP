// ---------------------------------------------------------------------------
// Threshold scaling by sex & bodyweight
// ---------------------------------------------------------------------------

export type ScaledThresholds = [number, number, number, number, number];

/**
 * Scale the 70kg-male anchor thresholds to the user's sex and bodyweight.
 * - Load benchmarks: allometric power scaling  value ∝ (bw / 70)^b, with the
 *   per-tier female/male ratio curve applied for female lifters.
 * - Rep benchmarks: heavier lifters need FEWER reps, so bodyweight scales
 *   inversely: value ∝ (70 / bw)^0.4.
 * This is the documented fallback model (spec #26): per-family curves over a
 * pinned snapshot — NOT claimed to equal exact bodyweight tables.
 */
export function scaleThresholds(
  benchmark: StrengthBenchmark,
  ctx?: StrengthBodyContext | null
): ScaledThresholds {
  if (!ctx || benchmark.family === 'none' || benchmark.family === 'duration') {
    return [...benchmark.thresholds] as ScaledThresholds;
  }
  const { sex, bodyweightKg } = ctx;
  const clampedBw = Math.min(BW_CLAMP_MAX, Math.max(BW_CLAMP_MIN, bodyweightKg));
  const gCurve = G_CURVES[benchmark.family];

  return benchmark.thresholds.map((refVal, idx) => {
    const g = sex === 'female' && gCurve ? gCurve[idx] : 1.0;
    const scaled = benchmark.mode === 'bodyweight_reps'
      ? refVal * g * Math.pow(REF_BW / clampedBw, EXPONENT_B.bodyweightReps)
      : refVal * g * Math.pow(clampedBw / REF_BW, sex === 'female' ? EXPONENT_B.female : EXPONENT_B.male);
    // Rep benchmarks stay integral; load benchmarks keep one decimal (min 1).
    return benchmark.mode === 'bodyweight_reps'
      ? Math.max(1, Math.round(scaled))
      : Math.max(1, Math.round(scaled * 10) / 10);
  }) as ScaledThresholds;
}

// ---------------------------------------------------------------------------
// Benchmark value → score (percentile-anchored, continuous, monotonic)
// ---------------------------------------------------------------------------

/** Asymptote factor controlling how fast scores approach 100 above Elite. */
const ELITE_APPROACH_RATE = 2;

/**
 * Map a benchmark value to the 0-100 relative strength index.
 *
 * Piecewise-linear interpolation between the five tier thresholds with anchors
 * [5, 20, 50, 80, 95]; below the first threshold the score scales linearly
 * 0 → 5; above the Elite threshold the score approaches 100 asymptotically
 * (value = 2×Elite ≈ 99.3) so Elite is never conflated with "maxed out".
 * Monotone and continuous by construction — no jumps at any threshold.
 */
export function scoreFromBenchmarkValue(
  value: number,
  thresholds: ScaledThresholds
): number {
  if (!Number.isFinite(value) || value <= 0) return 0;
  const [t1, t2, t3, t4, t5] = thresholds;
  const [a1, a2, a3, a4, a5] = THRESHOLD_SCORE_ANCHORS;

  if (value <= t1) return (value / t1) * a1;
  if (value <= t2) return a1 + ((value - t1) / (t2 - t1)) * (a2 - a1);
  if (value <= t3) return a2 + ((value - t2) / (t3 - t2)) * (a3 - a2);
  if (value <= t4) return a3 + ((value - t3) / (t4 - t3)) * (a4 - a3);
  if (value <= t5) return a4 + ((value - t4) / (t5 - t4)) * (a5 - a4);

  // Beyond Elite: 95 + 5·(1 − e^(−2·(v/t5 − 1))) — smooth, asymptotic to 100.
  const overshoot = value / t5 - 1;
  return a5 + (100 - a5) * (1 - Math.exp(-ELITE_APPROACH_RATE * overshoot));
}

/**
 * Tier for a benchmark VALUE via thresholds (highest threshold reached).
 * Equal to getStrengthTier(scoreFromBenchmarkValue(...)) for all inputs —
 * the property is asserted by tests so the two lookups cannot drift apart.
 */
export function getTierForBenchmarkValue(
  value: number,
  thresholds: ScaledThresholds
): StrengthLevelDefinition {
  const [t1, t2, t3, t4, t5] = thresholds;
  if (value >= t5) return STRENGTH_TIERS.elite;
  if (value >= t4) return STRENGTH_TIERS.advanced;
  if (value >= t3) return STRENGTH_TIERS.intermediate;
  if (value >= t2) return STRENGTH_TIERS.novice;
  return STRENGTH_TIERS.beginner;
}

/**
 * Next milestone: the lowest threshold above the current value, with its tier.
 */
export function getNextMilestoneForValue(
  value: number,
  thresholds: ScaledThresholds
): { targetValue: number; deltaValue: number; nextTier: StrengthLevelDefinition } | undefined {
  for (let i = 0; i < thresholds.length; i += 1) {
    if (value < thresholds[i]) {
      return {
        targetValue: thresholds[i],
        deltaValue: Number((thresholds[i] - value).toFixed(1)),
        nextTier: STRENGTH_TIERS[STRENGTH_TIER_ORDER[i]],
      };
    }
  }
  return undefined;
}
