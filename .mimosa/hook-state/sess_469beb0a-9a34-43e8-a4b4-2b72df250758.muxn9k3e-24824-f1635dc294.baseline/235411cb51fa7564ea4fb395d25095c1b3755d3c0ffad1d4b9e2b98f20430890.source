/**
 * Strength Standards V3 — the SINGLE source for strength tiers, benchmark
 * thresholds, and the benchmark-value → score → tier mapping.
 *
 * Guarantees (spec #2/#3/#4):
 * - Every tier label, color, anchor score, and threshold used anywhere in the
 *   app comes from this file. UI code must not re-derive tiers independently.
 * - A benchmark value at threshold t_i always yields anchor score a_i AND tier i,
 *   so score-based and threshold-based tier lookups can never disagree.
 * - The five anchors are percentile-inspired (5/20/50/80/95), NOT 20/40/60/80/100;
 *   reaching the Elite threshold scores 95, not 100 — "world class" is not the
 *   top of the scale.
 */
import { StrengthBodyContext } from '../types';

// ---------------------------------------------------------------------------
// Tier definitions (Beginner < Novice < Intermediate < Advanced < Elite)
// ---------------------------------------------------------------------------

export type StrengthTierKey = 'beginner' | 'novice' | 'intermediate' | 'advanced' | 'elite';

export interface StrengthLevelDefinition {
  key: StrengthTierKey;
  /** 1..5, ascending with strength. */
  level: number;
  /** Score anchor reached exactly at this tier's threshold. */
  anchorScore: number;
  zh: string;
  en: string;
  badgeBg: string;
  badgeText: string;
  description: string;
}

export const STRENGTH_TIERS: Record<StrengthTierKey, StrengthLevelDefinition> = {
  beginner: {
    key: 'beginner',
    level: 1,
    anchorScore: 5,
    zh: '初学',
    en: 'Beginner',
    badgeBg: 'bg-slate-200',
    badgeText: 'text-slate-800',
    description: '初学阶段：掌握动作规范，建立基础肌力',
  },
  novice: {
    key: 'novice',
    level: 2,
    anchorScore: 20,
    zh: '入门',
    en: 'Novice',
    badgeBg: 'bg-emerald-100',
    badgeText: 'text-emerald-800',
    description: '入门阶段：规律训练，力量开始系统提升',
  },
  intermediate: {
    key: 'intermediate',
    level: 3,
    anchorScore: 50,
    zh: '进阶',
    en: 'Intermediate',
    badgeBg: 'bg-blue-100',
    badgeText: 'text-blue-800',
    description: '进阶水平：达到大众训练者中位参考水平',
  },
  advanced: {
    key: 'advanced',
