/**
 * Muscle stimulus model V3 — public façade.
 *
 * The taxonomy, targets, and scoring curves live in muscleTaxonomy.ts (a leaf
 * module, kept import-cycle free); the per-exercise stimulus coefficients live
 * in exerciseDefinitions.ts keyed by canonical exercise id. This module glues
 * them together and keeps the historical import paths working.
 *
 * Stimulus coefficients are EFFECTIVE-SET equivalents (spec #14), not a
 * normalized "cake": compound lifts stimulate several muscles at once and may
 * sum to > 1 across muscles.
 */
import { EXERCISE_DEFINITIONS, resolveExerciseDefinition } from './exerciseDefinitions';
import { WorkoutCategory } from '../types';

// Taxonomy + curves (re-exported for all existing import sites).
export {
  SubMuscleGroup,
  CATEGORY_SUB_MUSCLES,
  SUB_MUSCLE_WEIGHTS,
  SUB_MUSCLE_TRAINING_TARGETS,
  TRAINING_SCORE_WEIGHTS,
  SCORE_WEIGHTS,
  FREQUENCY_BREAKPOINTS,
  PROGRESSION_BREAKPOINTS,
  PROGRESSION_NEUTRAL_SCORE,
  interpolateScore,
  volumeScoreForSets,
  SCORING_PERIOD_DAYS,
  CARDIO_CALORIE_TARGETS,
  DEFAULT_CARDIO_CALORIE_TARGET,
  SUB_MUSCLE_META,
  categoryOfSubMuscle,
} from './muscleTaxonomy';
export type { SubMuscleTrainingTarget } from './muscleTaxonomy';

export interface ExerciseStimulusView {
  id: string;
  name: string;
  primaryCategory: WorkoutCategory;
  /** Effective-set coefficients per sub-muscle (NOT normalized; may sum > 1). */
  subMuscles: Partial<Record<import('./muscleTaxonomy').SubMuscleGroup, number>>;
}

/** All defined exercises with their stimulus split — for UI coefficient tables. */
export function getExerciseStimulusTable(): ExerciseStimulusView[] {
  return EXERCISE_DEFINITIONS.map((d) => ({
    id: d.id,
    name: d.name,
    primaryCategory: d.primaryCategory,
    subMuscles: d.stimulusCoefficients,
  }));
}

/** Stimulus view for a single exercise name (compat alias for old lookups). */
export function findMuscleCoefficient(exerciseName: string): ExerciseStimulusView | undefined {
  const definition = resolveExerciseDefinition(exerciseName).definition;
  if (!definition) return undefined;
  return {
    id: definition.id,
    name: definition.name,
    primaryCategory: definition.primaryCategory,
    subMuscles: definition.stimulusCoefficients,
  };
}
