/**
 * Workout Analytics V3 — model invariant & boundary tests (spec #37-#43).
 *
 * These tests assert MATH PROPERTIES (monotonicity, anchor alignment, tier
 * continuity, confidence separation), not fixed magic numbers, so future
 * re-calibration of thresholds does not silently break the model.
 */
import { WorkoutCategory, WorkoutLog, StrengthBodyContext } from '../src/types';
import {
  resolveExerciseMuscles,
  calculateStandardizedScore,
  getStrengthTier,
  getNextMilestone,
  calculateFullWorkoutAnalytics,
  findExerciseStandard,
  estimateOneRepMax,
  bodyContextFromProfile,
  calculateEffectiveLoad,
  validateExercisePerformance,
  calculateCardioExerciseMetrics,
  calculateCardioScore,
  getCardioTier,
} from '../src/utils/workoutAnalytics';
import {
  estimateOneRepMaxDetailed,
  resolveBodyContext,
} from '../src/utils/strengthAssessment';
import {
  STRENGTH_TIERS,
  STRENGTH_TIER_ORDER,
  THRESHOLD_SCORE_ANCHORS,
  getStrengthTier as getTierFromScore,
  getTierForBenchmarkValue,
  scoreFromBenchmarkValue,
  scaleThresholds,
  STRENGTH_BENCHMARKS,
  BENCHMARK_PROVENANCE,
} from '../src/constants/strengthStandards';
import {
  getTrainingStateTier,
  TRAINING_STATE_TIERS,
} from '../src/constants/strengthStandards';
import { CATEGORY_META } from '../src/constants/workoutPresets';
import {
  SubMuscleGroup,
  SUB_MUSCLE_TRAINING_TARGETS,
  volumeScoreForSets,
  interpolateScore,
  FREQUENCY_BREAKPOINTS,
  DEFAULT_CARDIO_CALORIE_TARGET,
} from '../src/constants/muscleCoefficients';
import {
  EXERCISE_DEFINITIONS,
  resolveExerciseDefinition,
  canonicalExerciseKey,
} from '../src/constants/exerciseDefinitions';

function assert(condition: boolean, msg: string) {
  if (!condition) {
    console.error(`❌ FAILED: ${msg}`);
    process.exit(1);
  }
  console.log(`✅ PASSED: ${msg}`);
}

void estimateOneRepMax;
void calculateCardioExerciseMetrics;

const dayMs = 24 * 60 * 60 * 1000;
const now = new Date();
const daysAgo = (n: number, hour = 10) => {
  const d = new Date(now.getTime() - n * dayMs);
  d.setHours(hour, 0, 0, 0);
  return d.toISOString();
};

function makeLog(
  id: string,
  timestamp: string,
  exercises: Array<Partial<ImportedExercise> & { name: string; type?: 'strength' | 'cardio' }>,
  category: string = 'Chest'
): WorkoutLog {
  return {
    id,
    userId: 'u1',
    userName: 'Tester',
    userPhoto: '',
    timestamp,
    category,
    exercises: exercises.map((ex, i) => ({
      id: `${id}-e${i}`,
      name: ex.name,
      type: ex.type ?? 'strength',
      weight: ex.weight,
      sets: ex.sets ?? 3,
      reps: ex.reps ?? 8,
      duration: ex.duration,
      distance: ex.distance,
      calories: ex.calories,
    })),
    likesCount: 0,
    commentsCount: 0,
  };
}
type ImportedExercise = { name: string; weight?: number; sets?: number; reps?: number; duration?: number; distance?: number; calories?: number };

console.log('--- 1. Canonicalization (spec #35/#40) ---');
{
  const benchVariants = ['卧推', '杠铃卧推', '杠铃平板卧推', 'bench press'];
  const keys = benchVariants.map((n) => canonicalExerciseKey(n));
  assert(keys.every((k) => k === keys[0]), `Bench variants share one canonical id (${keys.join(' / ')})`);

  const pullVariants = ['引体', '引体向上', 'pull up', 'pullup', 'Pull-Up'];
  const pullKeys = pullVariants.map((n) => canonicalExerciseKey(n));
  assert(pullKeys.every((k) => k === pullKeys[0]), `Pull-up variants share one canonical id (${pullKeys.join(' / ')})`);

  // Distinct movements must NOT collapse: dumbbell bench ≠ barbell bench.
  assert(canonicalExerciseKey('哑铃卧推') !== canonicalExerciseKey('卧推'), 'Dumbbell bench stays distinct from barbell bench');
  assert(canonicalExerciseKey('上斜卧推') !== canonicalExerciseKey('卧推'), 'Incline bench stays distinct from flat bench');

  // Dumbbell recording semantics: 20kg means EACH hand holds 20kg (spec #15).
  const dumbLog = makeLog('db', daysAgo(1), [{ name: '哑铃卧推', weight: 20, sets: 4, reps: 10 }], 'Chest');
  const dumbAnalytics = calculateFullWorkoutAnalytics([dumbLog], {}, 28, null);
  const dbPr = dumbAnalytics.categorizedPrs.find((p) => p.name.includes('哑铃'));
  assert(dbPr?.weight === 20 && dbPr.loadMode === 'dumbbell_per_hand', `Dumbbell PR keeps the per-hand recorded weight and declares loadMode (got ${dbPr?.weight}kg, ${dbPr?.loadMode})`);
  assert(dumbAnalytics.categoryDetails[WorkoutCategory.Chest].totalVolumeKg === 1600, `Dumbbell tonnage counts both hands ×2 (4×10×20×2=1600, got ${dumbAnalytics.categoryDetails[WorkoutCategory.Chest].totalVolumeKg})`);

  // Top-3 aggregation dedupes aliases: two alias logs of the same lift = 1 PR.
  const logs = [
    makeLog('a', daysAgo(1), [{ name: '卧推', weight: 80, sets: 3, reps: 5 }]),
    makeLog('b', daysAgo(2), [{ name: '杠铃平板卧推', weight: 82.5, sets: 3, reps: 5 }]),
  ];
  const analytics = calculateFullWorkoutAnalytics(logs, {}, 28, { sex: 'male', bodyweightKg: 70 });
  const benchPrs = analytics.categorizedPrs.filter((p) => p.name.includes('卧推'));
  assert(benchPrs.length === 1, `Alias logs dedupe into a single PR entry (got ${benchPrs.length})`);
}

console.log('--- 2. Definition schema & muscle-mapping consistency (spec #13/#41) ---');
{
  const ids = new Set(EXERCISE_DEFINITIONS.map((d) => d.id));
  assert(ids.size === EXERCISE_DEFINITIONS.length, 'Canonical exercise ids are unique');

  // Alias exclusivity: no alias (or name) is claimed by two definitions.
  const claimOwner = new Map<string, string>();
  let aliasConflict: string | null = null;
  for (const d of EXERCISE_DEFINITIONS) {
    const claims = [d.name, ...d.aliases];
    for (const claim of claims) {
      const key = claim.toLowerCase().replace(/\s+/g, '');
      const prior = claimOwner.get(key);
      if (prior && prior !== d.id) { aliasConflict = `${claim} (${prior} vs ${d.id})`; }
      claimOwner.set(key, d.id);
    }
  }
  assert(aliasConflict === null, `No alias claimed by two definitions (conflict: ${aliasConflict})`);

  // Every benchmarked definition has a strictly-increasing threshold table.
  let benchmarkIssues: string[] = [];
  for (const d of EXERCISE_DEFINITIONS) {
    if (!d.hasStrengthBenchmark) continue;
    const b = STRENGTH_BENCHMARKS[d.id];
    if (!b) { benchmarkIssues.push(`${d.id}: missing benchmark`); continue; }
    const [t1, t2, t3, t4, t5] = b.thresholds;
    if (!(t1 < t2 && t2 < t3 && t3 < t4 && t4 < t5)) benchmarkIssues.push(`${d.id}: thresholds not strictly increasing`);
    if (!b.unit) benchmarkIssues.push(`${d.id}: missing unit`);
  }
  assert(benchmarkIssues.length === 0, `All benchmarks present and increasing (${benchmarkIssues.join('; ')})`);

  // Every benchmark has provenance metadata (spec #28).
  assert(
    BENCHMARK_PROVENANCE.source.length > 0 && BENCHMARK_PROVENANCE.sourceSnapshot.length > 0 && BENCHMARK_PROVENANCE.sourceType.length > 0,
    'Benchmark provenance (source/snapshot/type) is recorded'
  );

  // Stimulus coefficients reference known sub-muscles with positive values and
  // cover every category a benchmark credits (deadlift: legs + back, ONE source).
  const deadlift = resolveExerciseDefinition('传统硬拉').definition!;
  const deadliftCats = new Set(
    Object.keys(deadlift.stimulusCoefficients).map((sm) => {
      const cat = (Object.values(WorkoutCategory) as string[]).includes(sm) ? sm : null;
      void cat;
      return sm === 'Hamstrings' || sm === 'Glutes' || sm === 'Quads' || sm === 'Calves'
        ? WorkoutCategory.Legs
        : WorkoutCategory.Back;
    })
  );
  assert(
    deadliftCats.has(WorkoutCategory.Legs) && deadliftCats.has(WorkoutCategory.Back),
    'Conventional deadlift stimulates both Legs and Back from ONE definition'
  );
  const deadliftMuscles = resolveExerciseMuscles('传统硬拉');
  assert(deadliftMuscles[WorkoutCategory.Legs] > 0.2 && deadliftMuscles[WorkoutCategory.Back] > 0.2, `Legacy resolver agrees with the unified definition (legs ${deadliftMuscles.Legs}, back ${deadliftMuscles.Back})`);
  // RDL stays a legs benchmark with hamstrings as primary stimulus.
  const rdl = resolveExerciseDefinition('罗马尼亚硬拉').definition!;
  assert(rdl.primaryCategory === WorkoutCategory.Legs && (rdl.stimulusCoefficients[SubMuscleGroup.Hamstrings] ?? 0) >= 1.0, 'RDL: single benchmark source, hamstrings primary');

  // Compound stimulus sums may exceed 1 (effective sets, not a normalized cake).
  const benchDef = resolveExerciseDefinition('卧推').definition!;
  const benchSum = Object.values(benchDef.stimulusCoefficients).reduce((a, b) => a + (b || 0), 0);
  assert(benchSum > 1.0, `Bench press total stimulus > 1 set-equivalent (${benchSum.toFixed(2)})`);
}

console.log('--- 3. Estimated 1RM boundaries (spec #10/#11/#38) ---');
{
  const cases: Array<{ reps: number; conf: string; usable: boolean }> = [
    { reps: 1, conf: 'actual_1rm', usable: true },
    { reps: 3, conf: 'high', usable: true },
    { reps: 5, conf: 'high', usable: true },
    { reps: 8, conf: 'medium', usable: true },
    { reps: 10, conf: 'medium', usable: true },
    { reps: 11, conf: 'low', usable: true },
    { reps: 12, conf: 'low', usable: true },
    { reps: 15, conf: 'excluded', usable: false },
    { reps: 20, conf: 'excluded', usable: false },
  ];
  for (const c of cases) {
    const est = estimateOneRepMaxDetailed(80, c.reps);
    assert(est.repConfidence === c.conf && est.usableForStrength === c.usable, `reps=${c.reps} → confidence ${c.conf}, usable=${c.usable} (got ${est.repConfidence}/${est.usableForStrength})`);
  }
  // >12 reps must NOT be silently clamped to 10 (80×20 would give 106.7 if clamped).
  const est20 = estimateOneRepMaxDetailed(80, 20);
  assert(est20.estimated1RM === 0, 'High-rep sets are excluded from strength scoring, never silently clamped');

  // Monotonic in reps within the supported range.
  const chain = [1, 3, 5, 8, 10, 12].map((r) => estimateOneRepMaxDetailed(80, r).estimated1RM);
  assert(chain.every((v, i) => i === 0 || v > chain[i - 1]), `e1RM increases with reps (1..12): ${chain.join(' < ')}`);

  // Formula consensus: spread recorded and small for mid-range reps.
  const est8 = estimateOneRepMaxDetailed(80, 8);
  assert(est8.formula === 'consensus' && typeof est8.estimateSpread === 'number' && est8.estimateSpread < 0.06, `Consensus formula with recorded spread (${est8.estimateSpread})`);
}

console.log('--- 4. Score anchors, tier continuity & consistency (spec #2/#4/#37) ---');
{
  const bench = STRENGTH_BENCHMARKS['barbell_bench_press'];
  const [t1, t2, t3, t4, t5] = bench.thresholds;

  // Value at threshold t_i scores exactly anchor_i.
  const atThresholds = [t1, t2, t3, t4, t5].map((t) => scoreFromBenchmarkValue(t, bench.thresholds));
  assert(
    atThresholds.every((s, i) => Math.abs(s - THRESHOLD_SCORE_ANCHORS[i]) < 1e-6),
    `Threshold values map exactly to anchors 5/20/50/80/95 (got ${atThresholds.map((s) => s.toFixed(2)).join(', ')})`
  );
  // Reaching Elite does NOT equal 100.
  assert(atThresholds[4] < 99 && atThresholds[4] >= 95, `Elite threshold scores 95, not 100 (${atThresholds[4].toFixed(2)})`);

  // Monotone + continuous across the whole range.
  let prev = -1;
  let monotone = true;
  for (let v = 0; v <= 300; v += 0.5) {
    const s = scoreFromBenchmarkValue(v, bench.thresholds);
    if (s < prev - 1e-9) monotone = false;
    prev = s;
  }
  assert(monotone && prev > 95 && prev < 100, `Score is monotone over 0..300kg and asymptotic below 100 (end ${prev.toFixed(2)})`);

  // Tier continuity: ±0.1kg around every threshold never jumps two tiers.
  const tierLevel = (v: number) => getTierForBenchmarkValue(v, bench.thresholds).level;
  let continuityOk = true;
  for (const t of bench.thresholds) {
    const levels = [tierLevel(t - 0.1), tierLevel(t), tierLevel(t + 0.1)];
    if (Math.max(...levels) - Math.min(...levels) > 1) continuityOk = false;
  }
  assert(continuityOk, 'Crossing one threshold moves at most one tier');

  // Score-based and threshold-based tier lookups agree everywhere.
  let scoreTierConsistent = true;
  for (let v = 0; v <= 400; v += 0.5) {
    const s = scoreFromBenchmarkValue(v, bench.thresholds);
    if (getTierFromScore(s).key !== getTierForBenchmarkValue(v, bench.thresholds).key) { scoreTierConsistent = false; break; }
  }
  assert(scoreTierConsistent, 'getStrengthTier(score) === threshold tier for ALL values (P0 regression guard)');

  // Tier ordering & vocabulary: 初学 < 入门 < 进阶 < 高阶 < 精英.
  const zhOrder = STRENGTH_TIER_ORDER.map((k) => STRENGTH_TIERS[k].zh).join(' < ');
  assert(zhOrder === '初学 < 入门 < 进阶 < 高阶 < 精英', `Strength tier vocabulary is Beginner<Novice<Intermediate<Advanced<Elite (${zhOrder})`);
  const anchorsAscending = STRENGTH_TIER_ORDER.every((k, i) => i === 0 || STRENGTH_TIERS[k].anchorScore > STRENGTH_TIERS[STRENGTH_TIER_ORDER[i - 1]].anchorScore);
  assert(anchorsAscending, 'Anchor scores ascend with tiers');

  // calculateStandardizedScore agrees with the direct mapping.
  const viaCompat = calculateStandardizedScore('杠铃平板卧推', t3, WorkoutCategory.Chest);
  assert(Math.abs(viaCompat - THRESHOLD_SCORE_ANCHORS[2]) <= 1, `Compat standardized score hits the intermediate anchor (got ${viaCompat})`);
}

console.log('--- 5. Strength monotonicity in weight (spec #37) ---');
{
  const ctx: StrengthBodyContext = { sex: 'male', bodyweightKg: 74 };
  const scores = [60, 70, 80, 90, 100].map((w) =>
    calculateStandardizedScore('杠铃平板卧推', w, WorkoutCategory.Chest, ctx)
  );
  assert(scores.every((s, i) => i === 0 || s >= scores[i - 1]), `Heavier same-rep lifts never score lower (${scores.join(' ≤ ')})`);
}

console.log('--- 6. Bodyweight movement semantics (spec #8/#9/#39) ---');
{
  const ctx74: StrengthBodyContext = { sex: 'male', bodyweightKg: 74 };
  // Pull-up: assistance → bodyweight → added load, strictly monotonic.
  const pullCases = [-30, -15, 0, 10, 30];
  const pullScores = pullCases.map((ext) => {
    const perf = validateExercisePerformance('引体向上', ext, 10, 74);
    assert(perf.valid && perf.effectiveLoad === 74 + ext, `Pull-up ${ext}kg external → ${74 + ext}kg effective load`);
    return calculateStandardizedScore('引体向上', perf.estimated1RM, WorkoutCategory.Back, ctx74);
  });
  assert(pullScores.every((s, i) => i === 0 || s > pullScores[i - 1]), `Pull-up scores strictly monotonic from assistance to added load (${pullScores.join(' < ')})`);

  // Push-up: reps benchmark works with weight = 0 (bodyweight performance model).
  const pushUpScores = [10, 20, 40].map((reps) => {
    const analytics = calculateFullWorkoutAnalytics(
      [makeLog('pu', daysAgo(1), [{ name: '俯卧撑', weight: 0, sets: 3, reps }], 'Chest')],
      {}, 28, ctx74
    );
    return analytics.categoryDetails[WorkoutCategory.Chest].strengthScore;
  });
  assert(pushUpScores.every((s) => s > 0), `Push-up sets at weight=0 produce valid strength scores (${pushUpScores.join(', ')})`);
  assert(pushUpScores[0] < pushUpScores[1] && pushUpScores[1] < pushUpScores[2], `Push-up scores increase with reps (${pushUpScores.join(' < ')})`);

  // Dips: bodyweight + added load, effective-load benchmarks.
  const dipsScores = [0, 10, 30].map((added) => {
    const perf = validateExercisePerformance('双杠臂屈伸', added, 8, 74);
    assert(perf.valid && perf.effectiveLoad === 74 + added, `Dips +${added}kg → ${74 + added}kg effective load`);
    return calculateStandardizedScore('双杠臂屈伸', perf.estimated1RM, WorkoutCategory.Chest, ctx74);
  });
  assert(dipsScores.every((s, i) => i === 0 || s > dipsScores[i - 1]), `Dips scores strictly monotonic with added load (${dipsScores.join(' < ')})`);

  // Plank: seconds benchmark stays valid.
  const plankStd = STRENGTH_BENCHMARKS['plank'];
  assert(plankStd.unit === 'sec', 'Plank benchmark uses seconds (duration model)');
}

console.log('--- 7. Sex & bodyweight standards (spec #25/#26/#31/#37) ---');
{
  const bench = STRENGTH_BENCHMARKS['barbell_bench_press'];
  const male70 = scaleThresholds(bench, { sex: 'male', bodyweightKg: 70 });
  const female55 = scaleThresholds(bench, { sex: 'female', bodyweightKg: 55 });
  assert(female55.every((t, i) => t < male70[i]), `Female 55kg thresholds below male 70kg at every tier (${female55[2]} < ${male70[2]})`);

  // Same absolute squat load: a lighter lifter (relative strength) scores >= a heavier one.
  const scoreFor = (bw: number) => calculateStandardizedScore('杠铃深蹲', 100, WorkoutCategory.Legs, { sex: 'male', bodyweightKg: bw });
  assert(scoreFor(60) >= scoreFor(90), `Lighter lifter at the same absolute load is not scored worse (${scoreFor(60)} vs ${scoreFor(90)})`);

  // Sex-specific curves must not invert tiers (novice < elite for both sexes).
  for (const sex of ['male', 'female'] as const) {
    const t = scaleThresholds(bench, { sex, bodyweightKg: 70 });
    assert(getTierForBenchmarkValue(t[1], t).level < getTierForBenchmarkValue(t[4], t).level, `${sex}: novice threshold tiers below elite`);
  }

  // Missing profile → generic mode, never silently presented as personal.
  const generic = resolveBodyContext(null);
  assert(generic.assessmentMode === 'generic' && generic.ctx.bodyweightKg === 70 && generic.ctx.sex === 'male', 'Empty profile resolves to generic 70kg male reference mode');
  const partial = resolveBodyContext({ sex: 'female' });
  assert(partial.assessmentMode === 'partial', 'Sex-only profile resolves to partial mode (bw assumed)');
  const personalized = resolveBodyContext({ sex: 'male', bodyweightKg: 82 });
  assert(personalized.assessmentMode === 'personalized', 'Complete profile resolves to personalized mode');
  assert(bodyContextFromProfile({ sex: 'female', bodyweightKg: 35 })?.bodyweightKg === 45, 'Bodyweight clamped to 45kg minimum');
  assert(bodyContextFromProfile({}) === null, 'Empty profile compat returns null context');
}

console.log('--- 8. Outlier protection (spec #12) ---');
{
  const ctx: StrengthBodyContext = { sex: 'male', bodyweightKg: 74 };
  const baseLog = makeLog('ok', daysAgo(2), [{ name: '杠铃平板卧推', weight: 80, sets: 3, reps: 5 }], 'Chest');
  const clean = calculateFullWorkoutAnalytics([baseLog], {}, 28, ctx);
  const typosLog = makeLog('typo', daysAgo(1), [{ name: '杠铃平板卧推', weight: 800, sets: 1, reps: 1 }], 'Chest');
  const polluted = calculateFullWorkoutAnalytics([typosLog, baseLog], {}, 28, ctx);

  const typoPr = polluted.categorizedPrs.find((p) => p.weight >= 800);
  assert(Boolean(typoPr?.excludeFromScoring), 'Absolutely implausible PR is flagged excludeFromScoring and kept visible for review');
  assert(polluted.categoryDetails[WorkoutCategory.Chest].strengthScore === clean.categoryDetails[WorkoutCategory.Chest].strengthScore, 'Implausible PR does not move the chest strength score');

  // Personal jump: flagged but still counted (newbie gains must not be nuked).
  const jumpLogs = [
    makeLog('j1', daysAgo(40), [{ name: '杠铃平板卧推', weight: 70, sets: 3, reps: 5 }], 'Chest'),
    makeLog('j2', daysAgo(2), [{ name: '杠铃平板卧推', weight: 100, sets: 3, reps: 5 }], 'Chest'),
  ];
  const jumped = calculateFullWorkoutAnalytics(jumpLogs, {}, 60, ctx);
  const jumpPr = jumped.categorizedPrs.find((p) => p.name.includes('卧推'));
  assert(jumpPr?.suspectedOutlier === true && !jumpPr?.excludeFromScoring, 'Large personal jump is flagged suspectedOutlier without exclusion');
}

console.log('--- 9. Score ↔ confidence separation (spec #5/#43) ---');
{
  const ctx: StrengthBodyContext = { sex: 'male', bodyweightKg: 74 };
  // One movement: category score equals the exercise score — NO coverage damping.
  const benchLog = makeLog('b1', daysAgo(1), [{ name: '杠铃平板卧推', weight: 80, sets: 3, reps: 5 }], 'Chest');
  const single = calculateFullWorkoutAnalytics([benchLog], {}, 28, ctx);
  const chest = single.categoryDetails[WorkoutCategory.Chest];
  const exerciseScore = single.categorizedPrs.find((p) => p.name.includes('卧推'))!.score;
  assert(chest.strengthScore === exerciseScore, `Single-movement category score equals exercise score without coverage damping (${chest.strengthScore} vs ${exerciseScore})`);
  assert(Boolean(chest.strengthAssessment) && chest.strengthAssessment!.confidence !== undefined, 'Category strength carries an explicit confidence');

  // Adding a second, weaker movement: score shifts explainably, confidence never drops.
  const twoLogs = [
    benchLog,
    makeLog('b2', daysAgo(1), [{ name: '蝴蝶机夹胸', weight: 45, sets: 3, reps: 10 }], 'Chest'),
  ];
  const two = calculateFullWorkoutAnalytics(twoLogs, {}, 28, ctx);
  const chestTwo = two.categoryDetails[WorkoutCategory.Chest];
  assert(chestTwo.strengthAssessment!.confidenceScore >= chest.strengthAssessment!.confidenceScore, `Adding valid evidence does not lower confidence (${chest.strengthAssessment!.confidenceScore} → ${chestTwo.strengthAssessment!.confidenceScore})`);
  assert(chestTwo.strengthScore > 0 && chestTwo.strengthScore >= 0.6 * chest.strengthScore, `Adding a weaker machine movement does not collapse the score (${chest.strengthScore} → ${chestTwo.strengthScore})`);

  // Machine-only evidence caps confidence at medium-low.
  const machineOnly = calculateFullWorkoutAnalytics(
    [makeLog('m1', daysAgo(1), [{ name: '蝴蝶机夹胸', weight: 45, sets: 3, reps: 10 }], 'Chest')],
    {}, 28, ctx
  );
  assert(machineOnly.categoryDetails[WorkoutCategory.Chest].strengthAssessment!.confidence !== 'high', 'Machine-only evidence is capped below high confidence');
}

console.log('--- 10. Training capacity V3 (spec #16-#20/#42) ---');
{
  // A: one workout in 28 days → low score.
  const logsA = [makeLog('a1', daysAgo(3), [{ name: '杠铃平板卧推', weight: 80, sets: 4, reps: 8 }], 'Chest')];
  const a = calculateFullWorkoutAnalytics(logsA, {}, 28, null);
  const chestA = a.categoryDetails[WorkoutCategory.Chest];
  assert(chestA.trainingScore < 30, `User A (1×/month) scores low (<30, got ${chestA.trainingScore})`);

  // B: 2×/week for 4 weeks, 4 bench sets each session.
  const logsB: WorkoutLog[] = [];
  for (let week = 0; week < 4; week += 1) {
    for (const dayOffset of [2, 5]) {
      logsB.push(makeLog(`b-${week}-${dayOffset}`, daysAgo(week * 7 + dayOffset), [{ name: '杠铃平板卧推', weight: 80, sets: 4, reps: 8 }], 'Chest'));
    }
  }
  const b = calculateFullWorkoutAnalytics(logsB, {}, 28, null);
  const chestB = b.categoryDetails[WorkoutCategory.Chest];
  assert(chestB.trainingScore > chestA.trainingScore, `User B (2×/week) beats User A (${chestB.trainingScore} > ${chestA.trainingScore})`);
  assert(chestB.frequencyScore >= 80, `User B frequency ≈ 2/week scores ~80 (got ${chestB.frequencyScore})`);

  // C: same total volume crammed into a single week → lower consistency, lower total.
  const logsC: WorkoutLog[] = [];
  for (let day = 0; day < 8; day += 1) {
    logsC.push(makeLog(`c-${day}`, daysAgo(day + 1), [{ name: '杠铃平板卧推', weight: 80, sets: 4, reps: 8 }], 'Chest'));
  }
  const c = calculateFullWorkoutAnalytics(logsC, {}, 28, null);
  const chestC = c.categoryDetails[WorkoutCategory.Chest];
  assert(chestC.consistencyScore < chestB.consistencyScore, `Cramming week scores lower on consistency (${chestC.consistencyScore} < ${chestB.consistencyScore})`);
  assert(chestC.trainingScore < chestB.trainingScore, `Cramming scores lower overall (${chestC.trainingScore} < ${chestB.trainingScore})`);

  // D: same volume, e1RM rising → progression above flat.
  const logsDUp = [
    makeLog('d-base', daysAgo(35), [{ name: '杠铃平板卧推', weight: 60, sets: 4, reps: 8 }], 'Chest'),
    makeLog('d-cur', daysAgo(7), [{ name: '杠铃平板卧推', weight: 70, sets: 4, reps: 8 }], 'Chest'),
  ];
  const logsDFlat = [
    makeLog('d-base', daysAgo(35), [{ name: '杠铃平板卧推', weight: 70, sets: 4, reps: 8 }], 'Chest'),
    makeLog('d-cur', daysAgo(7), [{ name: '杠铃平板卧推', weight: 70, sets: 4, reps: 8 }], 'Chest'),
  ];
  const dUp = calculateFullWorkoutAnalytics(logsDUp, {}, 28, null).categoryDetails[WorkoutCategory.Chest];
  const dFlat = calculateFullWorkoutAnalytics(logsDFlat, {}, 28, null).categoryDetails[WorkoutCategory.Chest];
  assert(dUp.progressionScore > dFlat.progressionScore, `Rising e1RM scores higher progression (${dUp.progressionScore} > ${dFlat.progressionScore})`);

  // E: more light high-rep tonnage must NOT read as strength progress.
  const logsE = [
    makeLog('e-base', daysAgo(35), [{ name: '杠铃平板卧推', weight: 60, sets: 4, reps: 8 }], 'Chest'),
    makeLog('e-cur', daysAgo(7), [{ name: '杠铃平板卧推', weight: 40, sets: 8, reps: 20 }], 'Chest'),
  ];
  const e = calculateFullWorkoutAnalytics(logsE, {}, 28, null).categoryDetails[WorkoutCategory.Chest];
  assert(e.progressionScore <= dUp.progressionScore - 20, `Light high-rep volume is not misread as progression (${e.progressionScore} vs up ${dUp.progressionScore})`);

  // No baseline → neutral progression (50), not "excellent".
  assert(chestA.progressionScore === 50, `No baseline gives neutral progression 50 (got ${chestA.progressionScore})`);

  // Frequency curve has no 0→25 jump.
  const f0 = interpolateScore(0, FREQUENCY_BREAKPOINTS);
  const fSmall = interpolateScore(0.25, FREQUENCY_BREAKPOINTS);
  assert(f0 === 0 && fSmall < 15, `Frequency curve starts at 0 and ramps continuously (f(0)=${f0}, f(0.25)=${fSmall.toFixed(1)})`);

  // Volume: capped piecewise, no "12 sets forever = 100 then more is better".
  const target = SUB_MUSCLE_TRAINING_TARGETS[SubMuscleGroup.MiddleChest];
  assert(volumeScoreForSets(0, target) === 0, 'Volume score 0 at 0 sets');
  assert(volumeScoreForSets(target.upperUsefulSets + 10, target) === 100, 'Volume score caps at the useful upper bound (no endless reward)');
  assert(volumeScoreForSets(target.targetEffectiveSets, target) > volumeScoreForSets(target.minEffectiveSets, target), 'Volume score rises from min to target');

  // Training-state tier vocabulary is separate from strength tiers (spec #22).
  assert(getTrainingStateTier(90).zh === '训练充足' && getTrainingStateTier(90).zh !== '精英', 'Training score 90 maps to 训练充足, never 精英');
  const tierOrder = Object.values(TRAINING_STATE_TIERS).map((t) => t.minScore);
  assert(tierOrder.every((v, i) => i === 0 || v > tierOrder[i - 1]), 'Training tier cutoffs ascend');
}

console.log('--- 11. Milestones & compat APIs ---');
{
  const next = getNextMilestone('杠铃平板卧推', 50, null);
  assert(Boolean(next) && next!.targetWeight === STRENGTH_BENCHMARKS['barbell_bench_press'].thresholds[1], `Next milestone is the next tier threshold (${next?.targetWeight})`);
  assert(next!.nextTier.zh === '入门', `Next milestone tier label is 入门 (got ${next?.nextTier.zh})`);

  const std = findExerciseStandard('传统硬拉');
  assert(std?.primaryCategory === WorkoutCategory.Back, 'Compat findExerciseStandard resolves deadlift to its canonical primary category');
  const unknownMuscles = resolveExerciseMuscles('神秘训练器');
  assert(unknownMuscles[WorkoutCategory.Others] === 1, 'Unknown exercises fall back to Others attribution');
}

console.log('--- 12. Cardio model regression (unchanged five-dimension model) ---');
{
  const records = [1, 8, 15, 22].map((d) => ({
    ...calculateCardioExerciseMetrics({ id: 'r', name: '户外跑步', type: 'cardio' as const, duration: 30, distance: 5 }),
    timestamp: daysAgo(d),
  }));
  const cardio = calculateCardioScore(records, 28, Date.now());
  assert(cardio.score > 0 && cardio.score <= 100, `Cardio five-dimension score stays bounded (${cardio.score})`);
  assert(getCardioTier(cardio.score).zh.length > 0, 'Cardio tier lookup works');
  assert(DEFAULT_CARDIO_CALORIE_TARGET === 2000, 'Cardio calorie target unchanged');
  const cardioDetail = calculateFullWorkoutAnalytics(
    [makeLog('cardio', daysAgo(1), [{ name: '户外跑步', type: 'cardio', duration: 30, distance: 5 }], 'Cardio')],
    {}, 28, null
  ).categoryDetails[WorkoutCategory.Cardio];
  assert(cardioDetail.strengthScore === 0, 'Cardio never produces a strength score');
  assert(cardioDetail.cardioCalories?.target === DEFAULT_CARDIO_CALORIE_TARGET, 'Cardio calorie target surfaced in details');
}

console.log('--- 13. End-to-end sanity: example lifters (spec #50-H) ---');
{
  // User 1: 70kg male — bench 80×8, squat 100×5, deadlift 120×5.
  const u1 = calculateFullWorkoutAnalytics(
    [makeLog('u1', daysAgo(1), [
      { name: '杠铃平板卧推', weight: 80, sets: 4, reps: 8 },
      { name: '杠铃深蹲', weight: 100, sets: 4, reps: 5 },
      { name: '传统硬拉', weight: 120, sets: 3, reps: 5 },
    ], 'Chest')],
    {}, 28, { sex: 'male', bodyweightKg: 70 }
  );
  const u1Bench = u1.categorizedPrs.find((p) => p.name.includes('卧推'))!;
  assert(u1Bench.estimated1RM! > 100 && u1Bench.estimated1RM! < 103, `User1 bench 80×8 → e1RM ≈ 101.3 (got ${u1Bench.estimated1RM})`);
  assert(u1Bench.tier.zh === '进阶' || u1Bench.tier.zh === '入门', `User1 bench tier plausible (got ${u1Bench.tier.zh})`);
  assert(u1.categoryDetails[WorkoutCategory.Legs].strengthScore > 0, 'User1 legs strength populated by squat+deadlift');
  assert(u1.categoryDetails[WorkoutCategory.Back].strengthScore > 0, 'User1 back strength populated by deadlift');

  // User 2: 55kg female — bench 40×5, squat 65×6, deadlift 80×5.
  const u2 = calculateFullWorkoutAnalytics(
    [makeLog('u2', daysAgo(1), [
      { name: '杠铃平板卧推', weight: 40, sets: 4, reps: 5 },
      { name: '杠铃深蹲', weight: 65, sets: 4, reps: 6 },
      { name: '传统硬拉', weight: 80, sets: 3, reps: 5 },
    ], 'Chest')],
    {}, 28, { sex: 'female', bodyweightKg: 55 }
  );
  const u2Bench = u2.categorizedPrs.find((p) => p.name.includes('卧推'))!;
  assert(u2Bench.score > 30 && u2Bench.score < 80, `User2 female bench 40kg scores moderately (${u2Bench.score}, tier ${u2Bench.tier.zh})`);
  assert(u2Bench.tier.level >= 2, `User2 bench tier at least 入门 (got ${u2Bench.tier.zh})`);

  // User 3: 74kg male — bodyweight ×10 pull-ups and +10kg ×6.
  const u3 = calculateFullWorkoutAnalytics(
    [
      makeLog('u3a', daysAgo(2), [{ name: '引体向上', weight: 0, sets: 4, reps: 10 }], 'Back'),
      makeLog('u3b', daysAgo(1), [{ name: '引体向上', weight: 10, sets: 4, reps: 6 }], 'Back'),
    ],
    {}, 28, { sex: 'male', bodyweightKg: 74 }
  );
  const u3Pull = u3.categorizedPrs.find((p) => p.name.includes('引体'))!;
  // +10kg ×6 at 74kg → e1RM ≈ 84×1.2 = 100.8 effective load → solid tier.
  assert(u3Pull.weight === 84, `User3 weighted pull-up displays 84kg effective load (got ${u3Pull.weight})`);
  assert(u3Pull.tier.level >= 3, `User3 pull-up tier at least 进阶 (got ${u3Pull.tier.zh})`);
  const u3Back = u3.categoryDetails[WorkoutCategory.Back];
  assert(u3Back.strengthScore > 0, 'User3 back strength populated by pull-ups');
}

