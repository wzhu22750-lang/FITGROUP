// Public scoring detail models
// ---------------------------------------------------------------------------

export interface SubMuscleScoreDetail {
  subMuscle: SubMuscleGroup;
  zh: string;
  en: string;
  /** Weight inside the parent category composite (informational). */
  weight: number;
  score: number;
  frequencyScore: number;
  volumeScore: number;
  progressionScore: number;
  consistencyScore: number;
  weeklyFrequency: number;
  weeklyEffectiveSets: number;
  /** Per-muscle weekly effective-set targets { min, target, upper }. */
  targetSets: { min: number; target: number; upper: number };
  hasProgressionBaseline: boolean;
}

export interface CategoryScoreDetail {
  category: WorkoutCategory;
  zh: string;
  en: string;
  /** V3 training-state score: frequency+volume+progression+consistency. */
  trainingScore: number;
  /** Alias of trainingScore (backward compatibility). */
  compositeScore: number;
  /** Training-state tier for resistance categories; cardio tier for Cardio. */
  tier: TrainingStateTierDefinition | CardioTierMeta;
  /** Category strength assessment score (0 when no benchmark evidence). */
  strengthScore: number;
  /** Full strength assessment (tier/confidence/evidence); absent when no data. */
  strengthAssessment?: CategoryStrengthAssessment;
  cardioScore?: number;
  activityScore: number;
  frequencyScore: number;
  volumeScore: number;
  progressionScore: number;
  consistencyScore: number;
  weeklyWorkouts: number;
  /** Raw sets attributed by primary category (volume distribution view). */
  recentSets: number;
  /** Tonnage incl. load semantics (dumbbell ×2, bodyweight movements included). */
  totalVolumeKg: number;
  bestExerciseName?: string;
  bestRecordText?: string;
  bestRecordValue?: number;
  subMuscleScores?: SubMuscleScoreDetail[];
  /** Strength confidence shortcut for badges. */
  strengthConfidence?: ConfidenceLabel;
  cardioCalories?: {
    actual: number;
    target: number;
    completionRate: number;
    reported?: number;
    estimated?: number;
  };
  cardioMetrics?: CardioScoreBreakdown;
}

export interface RadarDataPoint {
  subject: string;
  category: WorkoutCategory;
  /** Training-state score (0-100). */
  composite: number;
  /** Category strength score (0-100); 0 for Cardio by design. */
  strength: number;
  /** Frequency score (0-100). */
  activity: number;
  fullMark: number;
}

export type LaggingStatus = 'none' | 'not_trained' | 'insufficient_data' | 'lagging';

export interface WorkoutInsights {
  /** Balance across the five RESISTANCE categories only (cardio excluded). */
  balanceScore: number;
  balanceLevel: '极度均衡' | '均衡良好' | '局部偏强' | '偏科明显' | '蓄势起步';
  dominantCategory?: WorkoutCategory;
  laggingCategory?: WorkoutCategory;
  /** Why laggingCategory was chosen; UI distinguishes weak vs missing data. */
  laggingStatus: LaggingStatus;
  dominantScore: number;
  laggingScore: number;
  highlights: string[];
  recommendations: string[];
}

export interface CategorizedPrItem {
  name: string;
  category: WorkoutCategory;
  /** Benchmark load of the best performance (per-hand for dumbbells, total for bodyweight lifts). */
  weight: number;
  unit: string;
  /** Load semantics of the recorded weight, so UI can annotate "per hand" etc. */
  loadMode?: LoadMode;
  score: number;
  estimated1RM?: number;
  tier: StrengthLevelDefinition;
  nextMilestone?: {
    targetWeight: number;
    deltaWeight: number;
    nextTier: StrengthLevelDefinition;
  };
  /** Where this PR record came from. */
  source?: StrengthDataSource;
  repRange?: number;
  confidence?: ConfidenceLabel;
  confidenceScore?: number;
  /** Flagged jump vs the lifter's own reliable history (kept, reviewable). */
  suspectedOutlier?: boolean;
  /** Fails absolute plausibility — shown for review, excluded from scoring. */
  excludeFromScoring?: boolean;
}

export interface VolumeDistributionItem {
  category: WorkoutCategory;
  zh: string;
  color: string;
  /** Inline-style-safe hex matching `color` */
  hex: string;
  sets: number;
  percentage: number;
  workoutCount: number;
}

export interface CardioTierMeta {
  key: 'cardio_start' | 'cardio_basic' | 'cardio_steady' | 'cardio_good' | 'cardio_excellent';
  level: number;
  score: number;
  zh: string;
  en: string;
  badgeBg: string;
  badgeText: string;
  description: string;
}

export interface CardioExerciseMetrics {
  name: string;
  canonicalName: string;
  met: number;
  durationMinutes: number;
  effectiveMinutes: number;
  distanceKm: number;
  weightedMinutes: number;
  intensityScore: number;
  intensityFactor: number;
  speedKph?: number;
  paceMinutesPerKm?: number;
  reportedCalories: number;
  estimatedCalories: number;
  calories: number;
  validForScoring: boolean;
  sessionWeight: number;
}

export interface CardioExerciseRecord extends CardioExerciseMetrics {
  timestamp: string;
}

const CARDIO_MINIMUM_SESSION_MINUTES = 5;
const CARDIO_NORMAL_SESSION_MINUTES = 10;
const CARDIO_SCORE_WEIGHTS = {
  frequency: 0.20,
  duration: 0.30,
  intensity: 0.25,
  volume: 0.15,
  consistency: 0.10,
} as const;

const CARDIO_DURATION_BREAKPOINTS: Array<[number, number]> = [
  [0, 0], [30, 20], [60, 40], [90, 60], [150, 80], [210, 95], [300, 100],
];
const CARDIO_VOLUME_BREAKPOINTS: Array<[number, number]> = [
  [0, 0], [30, 20], [60, 40], [100, 60], [150, 80], [220, 95], [300, 100],
];

function clampCardio(value: number, min: number, max: number): number {
  if (!Number.isFinite(value)) return min;
  return Math.min(max, Math.max(min, value));
}

function interpolateCardioScore(value: number, breakpoints: Array<[number, number]>): number {
  const safeValue = Math.max(0, Number.isFinite(value) ? value : 0);
  if (safeValue <= breakpoints[0][0]) return breakpoints[0][1];
  for (let i = 1; i < breakpoints.length; i += 1) {
    const [x1, y1] = breakpoints[i - 1];
    const [x2, y2] = breakpoints[i];
    if (safeValue <= x2) {
      const ratio = (safeValue - x1) / (x2 - x1);
      return y1 + ratio * (y2 - y1);
    }
  }
  return breakpoints[breakpoints.length - 1][1];
}

function localDateKey(timestamp: string): string {
  const date = new Date(timestamp);
  if (Number.isNaN(date.getTime())) return '';
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

export function calculateCardioIntensityScore(met: number): number {
  return Math.round(clampCardio(((met - 2.5) / 7.5) * 100, 0, 100));
}

export function calculateCardioIntensityFactor(met: number): number {
  return Number(clampCardio(0.5 + ((met - 3) / 7) * 0.5, 0.5, 1).toFixed(3));
}

export const CARDIO_TIERS: CardioTierMeta[] = [
  { key: 'cardio_start', level: 1, score: 0, zh: '起步', en: 'Starting', badgeBg: 'bg-slate-200', badgeText: 'text-slate-800', description: '建立稳定的有氧训练习惯' },
  { key: 'cardio_basic', level: 2, score: 20, zh: '基础', en: 'Basic', badgeBg: 'bg-emerald-100', badgeText: 'text-emerald-800', description: '开始形成有效的训练投入' },
  { key: 'cardio_steady', level: 3, score: 40, zh: '稳定', en: 'Steady', badgeBg: 'bg-blue-100', badgeText: 'text-blue-800', description: '有氧训练频率和时间较为稳定' },
  { key: 'cardio_good', level: 4, score: 60, zh: '良好', en: 'Good', badgeBg: 'bg-purple-100', badgeText: 'text-purple-800', description: '训练投入、强度和持续性表现良好' },
  { key: 'cardio_excellent', level: 5, score: 80, zh: '优秀', en: 'Excellent', badgeBg: 'bg-amber-300', badgeText: 'text-amber-950', description: '形成高质量且持续的有氧训练模式' },
];

export function getCardioTier(score: number): CardioTierMeta {
  const safeScore = clampCardio(score, 0, 100);
  if (safeScore >= 80) return CARDIO_TIERS[4];
  if (safeScore >= 60) return CARDIO_TIERS[3];
  if (safeScore >= 40) return CARDIO_TIERS[2];
  if (safeScore >= 20) return CARDIO_TIERS[1];
  return CARDIO_TIERS[0];
}

export function calculateCardioExerciseMetrics(
  exercise: Exercise,
  bodyweightKg = CARDIO_REFERENCE_BODYWEIGHT_KG
): CardioExerciseMetrics {
  const activity = resolveCardioActivity(exercise.name);
  const durationInput = typeof exercise.duration === 'number' && Number.isFinite(exercise.duration)
    ? clampCardio(exercise.duration, 0, CARDIO_MAX_DURATION_MINUTES)
    : 0;
  const distanceKm = typeof exercise.distance === 'number' && Number.isFinite(exercise.distance)
    ? clampCardio(exercise.distance, 0, CARDIO_MAX_DISTANCE_KM)
    : 0;
  const reportedCalories = exercise.caloriesSource !== 'estimated' && typeof exercise.calories === 'number' && Number.isFinite(exercise.calories) && exercise.calories > 0
    ? clampCardio(exercise.calories, 0, CARDIO_MAX_CALORIES)
    : 0;
  const fallbackSpeed = activity.meta?.fallbackSpeedKph;
  const inferredDuration = durationInput <= 0 && reportedCalories <= 0 && distanceKm > 0 && fallbackSpeed && fallbackSpeed > 0
    ? clampCardio((distanceKm / fallbackSpeed) * 60, 0, CARDIO_MAX_DURATION_MINUTES)
    : 0;
  const durationMinutes = durationInput > 0 ? durationInput : inferredDuration;
  const validForScoring = durationMinutes >= CARDIO_MINIMUM_SESSION_MINUTES;
  const effectiveMinutes = validForScoring ? durationMinutes : 0;
  const intensityScore = calculateCardioIntensityScore(activity.met);
  const intensityFactor = calculateCardioIntensityFactor(activity.met);
  const weightedMinutes = Number((effectiveMinutes * intensityFactor).toFixed(2));
  const estimatedCalories = reportedCalories === 0 && durationMinutes > 0
    ? estimateCardioCalories(exercise.name, durationMinutes, bodyweightKg)
    : 0;
  const calories = reportedCalories > 0 ? reportedCalories : estimatedCalories;
  const sessionWeight = validForScoring
    ? Number(Math.min(1, durationMinutes / CARDIO_NORMAL_SESSION_MINUTES).toFixed(3))
    : 0;
  const speedKph = distanceKm > 0 && durationMinutes > 0
    ? Number((distanceKm / (durationMinutes / 60)).toFixed(2))
    : undefined;
  const paceMinutesPerKm = distanceKm > 0 && durationMinutes > 0
    ? Number((durationMinutes / distanceKm).toFixed(2))
    : undefined;

  return {
    name: exercise.name?.trim() || '有氧训练',
    canonicalName: activity.name,
    met: activity.met,
    durationMinutes: Number(durationMinutes.toFixed(2)),
    effectiveMinutes: Number(effectiveMinutes.toFixed(2)),
    distanceKm: Number(distanceKm.toFixed(2)),
    weightedMinutes,
    intensityScore,
    intensityFactor,
    speedKph,
    paceMinutesPerKm,
    reportedCalories: Math.round(reportedCalories),
    estimatedCalories: Math.round(estimatedCalories),
    calories: Math.round(calories),
    validForScoring,
    sessionWeight,
  };
}

export function calculateCardioScore(
  records: CardioExerciseRecord[],
  periodDays = SCORING_PERIOD_DAYS,
  periodEndMs = Date.now()
): CardioScoreBreakdown {
  const safeDays = Math.max(1, Number.isFinite(periodDays) ? periodDays : SCORING_PERIOD_DAYS);
  const periodStartMs = periodEndMs - safeDays * 24 * 60 * 60 * 1000;
  const inWindowRecords = records.filter((record) => {
    const timestamp = new Date(record.timestamp).getTime();
    return Number.isFinite(timestamp) && timestamp >= periodStartMs && timestamp <= periodEndMs;
  });
  const validRecords = inWindowRecords.filter((record) => record.validForScoring);
  const weeks = Math.max(1, safeDays / 7);
  const weekCount = Math.max(1, Math.ceil(safeDays / 7));
  const weekDurationMs = safeDays * 24 * 60 * 60 * 1000 / weekCount;
  const days = new Map<string, { weekIndex: number; duration: number; weighted: number; sessionWeight: number; calories: number; reported: number; estimated: number; metDuration: number; intensityDuration: number; bestActivity?: string; bestActivityWeighted: number }>();
  validRecords.forEach((record) => {
    const timestamp = new Date(record.timestamp).getTime();
    const key = localDateKey(record.timestamp) || new Date(timestamp).toISOString().slice(0, 10);
    const weekIndex = Math.min(weekCount - 1, Math.max(0, Math.floor((timestamp - periodStartMs) / weekDurationMs)));
    const current = days.get(key) || { weekIndex, duration: 0, weighted: 0, sessionWeight: 0, calories: 0, reported: 0, estimated: 0, metDuration: 0, intensityDuration: 0, bestActivityWeighted: 0 };
    current.duration += record.effectiveMinutes;
    current.weighted += record.weightedMinutes;
    current.calories += record.calories;
    current.reported += record.reportedCalories;
    current.estimated += record.estimatedCalories;
    current.metDuration += record.met * record.effectiveMinutes;
    current.intensityDuration += record.intensityScore * record.effectiveMinutes;
    current.sessionWeight = Math.min(1, current.duration / CARDIO_NORMAL_SESSION_MINUTES);
    if (record.weightedMinutes > current.bestActivityWeighted) {
      current.bestActivity = record.name;
      current.bestActivityWeighted = record.weightedMinutes;
    }
    days.set(key, current);
  });

  const dayEntries = [...days.entries()];
  const effectiveMinutes = dayEntries.reduce((sum, [, day]) => sum + day.duration, 0);
  const weightedMinutes = dayEntries.reduce((sum, [, day]) => sum + day.weighted, 0);
  const weeklyEffectiveMinutes = effectiveMinutes / weeks;
  const weeklyWeightedMinutes = weightedMinutes / weeks;
  const weeklySessions = dayEntries.reduce((sum, [, day]) => sum + day.sessionWeight, 0) / weeks;
  const frequencyScore = interpolateCardioScore(weeklySessions, [[0, 0], [0.5, 20], [1, 40], [2, 70], [3, 90], [4, 100]]);
  const durationScore = interpolateCardioScore(weeklyEffectiveMinutes, CARDIO_DURATION_BREAKPOINTS);
  const volumeScore = interpolateCardioScore(weeklyWeightedMinutes, CARDIO_VOLUME_BREAKPOINTS);
  const intensityScore = effectiveMinutes > 0
    ? dayEntries.reduce((sum, [, day]) => sum + day.intensityDuration, 0) / effectiveMinutes
    : 0;
  const weeklySessionTotals = Array.from({ length: weekCount }, (_, index) =>
    dayEntries.reduce((sum, [, day]) => day.weekIndex === index ? sum + day.sessionWeight : sum, 0)
  );
  const activeWeeks = weeklySessionTotals.filter((value) => value > 0).length;
  const meanWeeklySessions = weeklySessionTotals.reduce((sum, value) => sum + value, 0) / weeklySessionTotals.length;
  const variance = weeklySessionTotals.reduce((sum, value) => sum + Math.pow(value - meanWeeklySessions, 2), 0) / weeklySessionTotals.length;
  const stability = meanWeeklySessions > 0 ? clampCardio(1 - Math.sqrt(variance) / meanWeeklySessions, 0, 1) : 0;
  const consistencyScore = meanWeeklySessions > 0
    ? (activeWeeks / weeklySessionTotals.length) * (60 + stability * 40)
    : 0;
  const reportedCalories = validRecords.reduce((sum, record) => sum + record.reportedCalories, 0);
  const estimatedCalories = validRecords.reduce((sum, record) => sum + record.estimatedCalories, 0);
  const calories = reportedCalories + estimatedCalories;
  const calorieTarget = DEFAULT_CARDIO_CALORIE_TARGET;
  const bestDay = [...dayEntries].sort(([, a], [, b]) => b.weighted - a.weighted)[0];
  const score = clampCardio(
    frequencyScore * CARDIO_SCORE_WEIGHTS.frequency +
      durationScore * CARDIO_SCORE_WEIGHTS.duration +
      intensityScore * CARDIO_SCORE_WEIGHTS.intensity +
      volumeScore * CARDIO_SCORE_WEIGHTS.volume +
      consistencyScore * CARDIO_SCORE_WEIGHTS.consistency,
    0,
    100
  );

  return {
    score: Math.round(score),
    frequencyScore: Math.round(frequencyScore),
    durationScore: Math.round(durationScore),
    intensityScore: Math.round(intensityScore),
    volumeScore: Math.round(volumeScore),
    consistencyScore: Math.round(consistencyScore),
    validSessions: dayEntries.length,
    activeDays: dayEntries.length,
    activeWeeks,
    effectiveMinutes: Math.round(effectiveMinutes),
    weightedMinutes: Math.round(weightedMinutes),
    weeklyEffectiveMinutes: Number(weeklyEffectiveMinutes.toFixed(1)),
    weeklyWeightedMinutes: Number(weeklyWeightedMinutes.toFixed(1)),
    weeklySessions: Number(weeklySessions.toFixed(2)),
    averageMet: effectiveMinutes > 0 ? Number((dayEntries.reduce((sum, [, day]) => sum + day.metDuration, 0) / effectiveMinutes).toFixed(2)) : 0,
    reportedCalories,
    estimatedCalories,
    calories,
    calorieTarget,
    calorieCompletionRate: Math.round(clampCardio((calories / calorieTarget) * 100, 0, 100)),
    bestActivityName: bestDay?.[1].bestActivity,
  };
}

// ---------------------------------------------------------------------------
// Exercise-name compatibility helpers (used by dataExport + legacy callers)
// ---------------------------------------------------------------------------

/**
 * Normalized category shares for an exercise (sums to 1). Backed by the
 * canonical stimulus coefficients grouped by category; unknown exercises fall
 * back to keyword rules. This is an ATTRIBUTION view for legacy callers —
 * training-capacity math uses raw effective-set coefficients instead.
 */
export function resolveExerciseMuscles(
  exerciseName: string,
  fallbackCategories?: WorkoutCategory[] | string[] | string
): Record<WorkoutCategory, number> {
  const result: Record<WorkoutCategory, number> = {
    [WorkoutCategory.Chest]: 0,
    [WorkoutCategory.Back]: 0,
    [WorkoutCategory.Legs]: 0,
    [WorkoutCategory.Shoulders]: 0,
    [WorkoutCategory.Others]: 0,
    [WorkoutCategory.Cardio]: 0,
  };

  const definition = resolveExerciseDefinition(exerciseName).definition;
  if (definition) {
    let total = 0;
    for (const [smStr, coefficient] of Object.entries(definition.stimulusCoefficients)) {
      const cat = categoryOfSubMuscle(smStr as SubMuscleGroup);
      const c = coefficient || 0;
      if (!cat || c <= 0) continue;
      result[cat] += c;
      total += c;
    }
    if (total > 0) {
      (Object.keys(result) as WorkoutCategory[]).forEach((cat) => {
        result[cat] = Number((result[cat] / total).toFixed(3));
      });
      return result;
    }
  }

  const clean = normalizeExerciseName(exerciseName);
  const matchedCategories = new Set<WorkoutCategory>();

  if (clean.includes('胸') || clean.includes('卧推') || clean.includes('夹胸') || clean.includes('pushup') || clean.includes('bench') || clean.includes('chest')) {
    matchedCategories.add(WorkoutCategory.Chest);
  }
  if (clean.includes('背') || clean.includes('划船') || clean.includes('下拉') || clean.includes('引体') || clean.includes('deadlift') || clean.includes('pull') || clean.includes('row')) {
    matchedCategories.add(WorkoutCategory.Back);
  }
  if (clean.includes('蹲') || clean.includes('腿') || clean.includes('臀') || clean.includes('提踵') || clean.includes('倒蹬') || clean.includes('箭步') || clean.includes('squat') || clean.includes('lunge') || clean.includes('leg')) {
    matchedCategories.add(WorkoutCategory.Legs);
  }
  if (clean.includes('肩') || clean.includes('推举') || clean.includes('侧平举') || clean.includes('飞鸟') || clean.includes('面拉') || clean.includes('耸肩') || clean.includes('shoulder') || clean.includes('press') || clean.includes('delt')) {
    matchedCategories.add(WorkoutCategory.Shoulders);
  }
  if (clean.includes('弯举') || clean.includes('臂屈伸') || clean.includes('二头') || clean.includes('三头') || clean.includes('手臂') || clean.includes('腹') || clean.includes('核心') || clean.includes('支撑') || clean.includes('arm') || clean.includes('abs') || clean.includes('curl')) {
    matchedCategories.add(WorkoutCategory.Others);
  }
  if (
    clean.includes('跑') || clean.includes('骑') || clean.includes('单车') || clean.includes('跳绳') ||
    clean.includes('爬楼') || clean.includes('椭圆') || clean.includes('有氧') || clean.includes('cardio') ||
    clean.includes('run') || clean.includes('hiit') || clean.includes('羽毛球') || clean.includes('篮球') ||
    clean.includes('足球') || clean.includes('乒乓') || clean.includes('网球') || clean.includes('游泳') ||
    clean.includes('拳击') || clean.includes('搏击') || clean.includes('散步') || clean.includes('健走') ||
    clean.includes('瑜伽') || clean.includes('普拉提') || clean.includes('尊巴') || clean.includes('swim')
  ) {
    matchedCategories.add(WorkoutCategory.Cardio);
  }
  // Compound exception: conventional deadlift stimulates legs AND back.
  if (clean.includes('硬拉') || clean.includes('deadlift')) {
    matchedCategories.delete(WorkoutCategory.Back);
    matchedCategories.add(WorkoutCategory.Back);
    matchedCategories.add(WorkoutCategory.Legs);
  }

  if (matchedCategories.size > 0) {
    const share = 1 / matchedCategories.size;
    matchedCategories.forEach((cat) => {
      result[cat] = share;
    });
    return result;
  }

  let cats: WorkoutCategory[] = [];
  if (Array.isArray(fallbackCategories)) {
    cats = fallbackCategories.filter((c) => Object.values(WorkoutCategory).includes(c as WorkoutCategory)) as WorkoutCategory[];
  } else if (typeof fallbackCategories === 'string') {
    cats = parseCategories(fallbackCategories);
  }

  if (cats.length > 0) {
    const share = 1 / cats.length;
    cats.forEach((cat) => {
      result[cat] = share;
    });
    return result;
  }

  result[WorkoutCategory.Others] = 1.0;
  return result;
}

/** Compat view for callers that only need identity + category (e.g. dataExport). */
export interface ExerciseStandardCompat {
  name: string;
  primaryCategory: WorkoutCategory;
  /** Canonical exercise id ('' when the name is unknown). */
  id: string;
  hasStrengthBenchmark: boolean;
}

export function findExerciseStandard(name: string): ExerciseStandardCompat | undefined {
  if (!name) return undefined;
  const { definition } = resolveExerciseDefinition(name);
  if (!definition) return undefined;
  return {
    name: definition.name,
    primaryCategory: definition.primaryCategory,
    id: definition.id,
    hasStrengthBenchmark: definition.hasStrengthBenchmark,
  };
}

/** Legacy semantic: effective load used for PR display (bodyweight lifts include bw). */
export function calculateEffectiveLoad(
  exerciseName: string,
  externalLoad: number,
  bodyweightKg: number = REF_BW
): number {
  const definition = resolveExerciseDefinition(exerciseName).definition;
  return resolvePerformanceLoad(definition, exerciseName, externalLoad, bodyweightKg).effectiveTotalLoad;
}

/** Backward-compatible name; the returned value is the effective total load. */
export const resolveEffectiveExerciseWeight = calculateEffectiveLoad;

/** True for pull-up style movements (display helper for dataExport). */
export function isPullUpExercise(name: string): boolean {
  if (!name) return false;
  const clean = normalizeExerciseName(name);
  return clean.includes('引体') || clean.includes('pullup') || clean.includes('chinup');
}

/**
 * Tonnage for one logged exercise with explicit load semantics:
 * dumbbell_per_hand bilateral ×2, bodyweight movements count bw+external,
 * unilateral counts one side (recorded sets are per-side work).
 */
export function resolveExerciseTonnage(
  exerciseName: string,
  externalLoad: number,
  sets: number,
  reps: number,
  bodyweightKg: number = REF_BW
): number {
  const definition = resolveExerciseDefinition(exerciseName).definition;
  const load = resolvePerformanceLoad(definition, exerciseName, externalLoad, bodyweightKg);
  const safeSets = Math.max(0, Number.isFinite(sets) ? sets : 0);
  const safeReps = Math.max(0, Number.isFinite(reps) ? reps : 0);
  const loadPerRep = load.loadMode === 'bodyweight' || load.loadMode === 'bodyweight_plus_external'
    ? load.effectiveTotalLoad
    : load.benchmarkLoad;
  return loadPerRep * load.tonnageMultiplier * safeSets * safeReps;
}

/** Epley kept for direct callers; analytics uses the consensus estimate. */
export function estimateOneRepMax(effectiveLoad: number, reps: number): number {
  if (!Number.isFinite(effectiveLoad) || effectiveLoad <= 0 || !Number.isFinite(reps) || reps <= 0) return 0;
  if (reps <= 1) return Number(effectiveLoad.toFixed(1));
  return Number((effectiveLoad * (1 + Math.min(10, Math.max(1, Math.round(reps))) / 30)).toFixed(1));
}

export interface ExercisePerformanceValidation {
  valid: boolean;
  reason?: string;
  externalLoad: number;
  bodyweight: number;
  effectiveLoad: number;
  estimated1RM: number;
}

/**
 * Validate a raw logged performance. Reps > 12 are NOT silently clamped:
 * they stay valid for volume but carry no estimated1RM (spec #10).
 */
export function validateExercisePerformance(
  exerciseName: string,
  externalLoad: number,
  reps: number,
  bodyweightKg: number = REF_BW
): ExercisePerformanceValidation {
  const bodyweight = Number.isFinite(bodyweightKg) && bodyweightKg > 0 ? bodyweightKg : REF_BW;
  const definition = resolveExerciseDefinition(exerciseName).definition;
  const load = resolvePerformanceLoad(definition, exerciseName, externalLoad, bodyweight);
  const effectiveLoad = load.effectiveTotalLoad;
  const isBodyweightLoad = load.loadMode === 'bodyweight' || load.loadMode === 'bodyweight_plus_external';
  const benchmarkLoad = isBodyweightLoad ? load.effectiveTotalLoad : load.benchmarkLoad;
  const safeReps = Number.isFinite(reps) ? reps : 0;

  if (!Number.isFinite(externalLoad)) {
    return { valid: false, reason: 'externalLoad is not finite', externalLoad: 0, bodyweight, effectiveLoad: 0, estimated1RM: 0 };
  }
  if (!Number.isFinite(safeReps) || safeReps <= 0 || !Number.isInteger(safeReps)) {
    return { valid: false, reason: 'reps must be a positive integer', externalLoad, bodyweight, effectiveLoad, estimated1RM: 0 };
  }
  if (isBodyweightLoad && effectiveLoad <= 0) {
    return { valid: false, reason: 'effectiveLoad must be positive', externalLoad, bodyweight, effectiveLoad: 0, estimated1RM: 0 };
  }
  const estimate = estimateOneRepMaxDetailed(benchmarkLoad, safeReps);
  if (!estimate.usableForStrength) {
    return { valid: true, externalLoad, bodyweight, effectiveLoad, estimated1RM: 0 };
  }
  if (!Number.isFinite(estimate.estimated1RM) || estimate.estimated1RM <= 0 || estimate.estimated1RM > 5000) {
    return { valid: false, reason: 'estimated1RM is outside the supported range', externalLoad, bodyweight, effectiveLoad, estimated1RM: 0 };
  }
  return { valid: true, externalLoad, bodyweight, effectiveLoad, estimated1RM: estimate.estimated1RM };
}

/**
 * Standardized 0-100 score for a benchmark value (compat API).
 * Percentile-anchored interpolation against the exercise's scaled thresholds.
 */
export function calculateStandardizedScore(
  exerciseName: string,
  value: number,
  category: WorkoutCategory,
  ctx?: StrengthBodyContext | null
): number {
  if (!Number.isFinite(value) || value <= 0) return 0;
  const { definition } = resolveExerciseDefinition(exerciseName);
  const benchmark = definition ? STRENGTH_BENCHMARKS[definition.id] : undefined;
  if (definition && benchmark) {
    const scaled = scaleBenchmarkThresholds(benchmark, ctx);
    return Math.min(100, Math.round(scoreFromBenchmarkValue(value, scaled)));
  }
  // Unknown exercise: neutral category fallback table (legacy behavior).
  const fallback: Record<WorkoutCategory, ScaledThresholds> = {
    [WorkoutCategory.Chest]: [30, 50, 75, 100, 125],
    [WorkoutCategory.Back]: [30, 50, 70, 90, 115],
    [WorkoutCategory.Legs]: [40, 70, 100, 140, 180],
    [WorkoutCategory.Shoulders]: [15, 30, 45, 60, 75],
    [WorkoutCategory.Others]: [15, 25, 35, 45, 55],
    [WorkoutCategory.Cardio]: [15, 30, 45, 60, 90],
  };
  return Math.min(100, Math.round(scoreFromBenchmarkValue(value, fallback[category] ?? fallback[WorkoutCategory.Others])));
}

/** Compat assessment API — tier always derived from the same thresholds. */
export function resolveStrengthAssessment(
  exerciseName: string,
  value: number,
  category?: WorkoutCategory,
  ctx?: StrengthBodyContext | null
): { score: number; tier: StrengthLevelDefinition; nextMilestone?: CategorizedPrItem['nextMilestone'] } {
  const { definition } = resolveExerciseDefinition(exerciseName);
  const benchmark = definition ? STRENGTH_BENCHMARKS[definition.id] : undefined;
  const score = calculateStandardizedScore(
    exerciseName,
    value,
    category || definition?.primaryCategory || WorkoutCategory.Others,
    ctx
  );
  if (!definition || !benchmark || value <= 0) {
    return { score, tier: getStrengthTier(score) };
  }
  const scaled = scaleBenchmarkThresholds(benchmark, ctx);
  return {
    score,
    tier: getTierForBenchmarkValue(value, scaled),
    nextMilestone: getNextMilestone(exerciseName, value, ctx),
  };
}

/** Compat milestone API. */
export function getNextMilestone(
  exerciseName: string,
  currentWeight: number,
  ctx?: StrengthBodyContext | null
): CategorizedPrItem['nextMilestone'] {
  const { definition } = resolveExerciseDefinition(exerciseName);
  const benchmark = definition ? STRENGTH_BENCHMARKS[definition.id] : undefined;
  if (!definition || !benchmark) return undefined;
  const scaled = scaleBenchmarkThresholds(benchmark, ctx);
  const milestone = getNextMilestoneForValue(currentWeight, scaled);
  if (!milestone) return undefined;
  return {
    targetWeight: milestone.targetValue,
    deltaWeight: milestone.deltaValue,
    nextTier: milestone.nextTier,
  };
}

/** Personalized thresholds for the standards table UI. */
export function getBenchmarkThresholdsForDisplay(
  exerciseName: string,
  ctx?: StrengthBodyContext | null
): { name: string; unit: string; thresholds: ScaledThresholds } | undefined {
  const { definition } = resolveExerciseDefinition(exerciseName);
  const benchmark = definition ? STRENGTH_BENCHMARKS[definition.id] : undefined;
  if (!definition || !benchmark) return undefined;
  return {
    name: definition.name,
    unit: benchmark.unit,
    thresholds: scaleBenchmarkThresholds(benchmark, ctx),
  };
}

export { getStrengthTier, getTrainingStateTier } from '../constants/strengthStandards';

// ---------------------------------------------------------------------------
// Full analytics orchestration
// ---------------------------------------------------------------------------

interface PerformanceCandidate {
  canonicalKey: string;
  name: string;
  definition?: ExerciseDefinition;
  timestamp: number;
  benchmarkLoad: number;
  estimated1RM: number;
  repRange: number;
  estimate: OneRepMaxEstimate;
  suspectedOutlier: boolean;
  excludeFromScoring: boolean;
  source: StrengthDataSource;
}

/**
 * Complete analytics calculation (V3):
 * - Training capacity: frequency + effective volume + progression + consistency
 *   over a rolling window, computed per sub-muscle then weighted per category.
 * - Strength: canonicalized performances → consensus e1RM → plausibility →
 *   population benchmark (percentile anchors) → reliability-weighted category
 *   assessment with separate confidence.
 * - Cardio keeps its independent five-dimension model on a fixed 28-day window.
 */
export function calculateFullWorkoutAnalytics(
  logs: WorkoutLog[],
  userPrs: Record<string, number> = {},
  days = SCORING_PERIOD_DAYS,
  ctx?: StrengthBodyContext | null
): {
  categoryDetails: Record<WorkoutCategory, CategoryScoreDetail>;
  radarData: RadarDataPoint[];
  volumeDistribution: VolumeDistributionItem[];
  insights: WorkoutInsights;
  categorizedPrs: CategorizedPrItem[];
  recentWorkoutsCount: number;
  recentSetsCount: number;
} {
  const now = Date.now();
  const safeDays = Math.max(1, days);
  const currentPeriodMs = safeDays * 24 * 60 * 60 * 1000;
  const cutoffTime = now - currentPeriodMs;
  const baselineCutoffTime = cutoffTime - currentPeriodMs;
  const weekCount = Math.max(1, Math.ceil(safeDays / 7));
  const weekDurationMs = currentPeriodMs / weekCount;

  const recentLogs = logs.filter((l) => {
    const t = new Date(l.timestamp).getTime();
    return !isNaN(t) && t >= cutoffTime && t <= now;
  });
  const baselineLogs = logs.filter((l) => {
    const t = new Date(l.timestamp).getTime();
    return !isNaN(t) && t >= baselineCutoffTime && t < cutoffTime;
  });

  const resolvedBody = resolveBodyContext(ctx ?? undefined);
  const bodyweightKg = resolvedBody.ctx.bodyweightKg;

  // ------------------------------------------------------------------
  // Shared accumulators (training pipeline)
  // ------------------------------------------------------------------
  const emptyStats = (): SubMuscleTrainingStats => ({
    subMuscle: SubMuscleGroup.Abs,
    trainingDays: 0,
    effectiveSets: 0,
    weeklyEffectiveSets: new Array(weekCount).fill(0),
  });

  const currentStats = new Map<SubMuscleGroup, SubMuscleTrainingStats>();
  const workoutDatesByMuscle = new Map<SubMuscleGroup, Set<string>>();
  const baselineEffectiveSets = new Map<SubMuscleGroup, number>();

  const categorySets: Record<WorkoutCategory, number> = zeroCategories();
  const categoryTonnage: Record<WorkoutCategory, number> = zeroCategories();
  const categoryWorkoutOccurrences: Record<WorkoutCategory, number> = zeroCategories();

  const cardioRecords: CardioExerciseRecord[] = logs.flatMap((log) =>
    (Array.isArray(log.exercises) ? log.exercises : [])
      .filter((exercise) => exercise.type === 'cardio' || isCardioExercise(exercise.name))
      .map((exercise) => ({
        ...calculateCardioExerciseMetrics(exercise, bodyweightKg),
        timestamp: log.timestamp,
      }))
  );

  const processLogExercises = (log: WorkoutLog, isCurrent: boolean) => {
    const dateKey = log.timestamp ? log.timestamp.split('T')[0] : '';
    const timestamp = new Date(log.timestamp).getTime();
    const weekIndex = Number.isFinite(timestamp)
      ? Math.min(weekCount - 1, Math.max(0, Math.floor((timestamp - (now - currentPeriodMs)) / weekDurationMs)))
      : 0;
    const logCategories = parseCategories(typeof log.category === 'string' ? log.category : '');
    const exercises = Array.isArray(log.exercises) ? log.exercises : [];
    const touchedPrimaryCategories = new Set<WorkoutCategory>();

    exercises.forEach((ex) => {
      if (ex.type === 'cardio' || isCardioExercise(ex.name)) return;
      const sets = Math.max(0, ex.sets || 0);
      if (sets <= 0) return;
      const reps = Math.max(0, ex.reps || 0);

      const { definition } = resolveExerciseDefinition(ex.name);
      // Primary category: canonical definition first, muscle-share fallback otherwise.
      const muscleShares = definition ? undefined : resolveExerciseMuscles(ex.name, logCategories);
      const primary = definition?.primaryCategory
        ?? (Object.entries(muscleShares ?? {}) as Array<[WorkoutCategory, number]>)
          .sort((a, b) => b[1] - a[1])[0]?.[0]
        ?? WorkoutCategory.Others;
      const tonnage = resolveExerciseTonnage(ex.name, typeof ex.weight === 'number' ? ex.weight : 0, sets, reps, bodyweightKg);

      // Volume distribution + tonnage: primary-category attribution (sums to raw sets).
      categorySets[primary] += sets;
      categoryTonnage[primary] += tonnage;
      touchedPrimaryCategories.add(primary);

      // Effective-set stimulus accumulators (overlap allowed across muscles).
      const coefficients = definition?.stimulusCoefficients;
      if (coefficients && Object.keys(coefficients).length > 0) {
        for (const [smStr, coefficient] of Object.entries(coefficients)) {
          const sm = smStr as SubMuscleGroup;
          const c = coefficient || 0;
          if (c <= 0) continue;
          if (isCurrent) {
            const stats = currentStats.get(sm) ?? emptyStats();
            stats.subMuscle = sm;
            stats.effectiveSets += sets * c;
            stats.weeklyEffectiveSets[weekIndex] += sets * c;
            currentStats.set(sm, stats);
            if (dateKey) {
              const dates = workoutDatesByMuscle.get(sm) ?? new Set<string>();
              dates.add(dateKey);
              workoutDatesByMuscle.set(sm, dates);
            }
          } else {
            baselineEffectiveSets.set(sm, (baselineEffectiveSets.get(sm) ?? 0) + sets * c);
          }
        }
      } else {
        // Unknown exercise: primary category gets full stimulus, split across
        // its sub-muscles by configured weights.
        const subMuscles = CATEGORY_SUB_MUSCLES[primary] || [];
        const weights = SUB_MUSCLE_WEIGHTS[primary] || {};
        const weightSum = subMuscles.reduce((sum, sm) => sum + (weights[sm] ?? 1 / Math.max(1, subMuscles.length)), 0) || 1;
        subMuscles.forEach((sm) => {
          const share = (weights[sm] ?? 1 / Math.max(1, subMuscles.length)) / weightSum;
          if (isCurrent) {
            const stats = currentStats.get(sm) ?? emptyStats();
            stats.subMuscle = sm;
            stats.effectiveSets += sets * share;
            stats.weeklyEffectiveSets[weekIndex] += sets * share;
            currentStats.set(sm, stats);
            if (dateKey) {
              const dates = workoutDatesByMuscle.get(sm) ?? new Set<string>();
              dates.add(dateKey);
              workoutDatesByMuscle.set(sm, dates);
            }
          } else {
            baselineEffectiveSets.set(sm, (baselineEffectiveSets.get(sm) ?? 0) + sets * share);
          }
        });
      }
    });

    if (isCurrent) {
      touchedPrimaryCategories.forEach((cat) => {
        categoryWorkoutOccurrences[cat] += 1;
      });
    }
  };

  recentLogs.forEach((log) => processLogExercises(log, true));
  baselineLogs.forEach((log) => processLogExercises(log, false));

  // Training days per muscle come from the current window's workout dates.
  workoutDatesByMuscle.forEach((dates, sm) => {
    const stats = currentStats.get(sm) ?? emptyStats();
    stats.trainingDays = dates.size;
    currentStats.set(sm, stats);
  });

  // Cardio keeps a fixed 28-day window regardless of the caller's volume view.
  const cardioSummary = calculateCardioScore(cardioRecords, SCORING_PERIOD_DAYS, now);
  categorySets[WorkoutCategory.Cardio] = cardioSummary.validSessions;
  categoryWorkoutOccurrences[WorkoutCategory.Cardio] = cardioSummary.validSessions;

  // ------------------------------------------------------------------
  // Strength pipeline: canonicalized performances → assessments
  // ------------------------------------------------------------------
  const performancesByKey = new Map<string, PerformanceCandidate[]>();
  const pushPerformance = (candidate: PerformanceCandidate) => {
    const list = performancesByKey.get(candidate.canonicalKey) ?? [];
    list.push(candidate);
    performancesByKey.set(candidate.canonicalKey, list);
  };

  const collectFromLog = (log: WorkoutLog) => {
    (log.exercises || []).forEach((ex) => {
      if (ex.type !== 'strength' || typeof ex.weight !== 'number' || !ex.name) return;
      const reps = ex.reps || 1;
      if (!Number.isFinite(reps) || reps <= 0 || !Number.isInteger(reps)) return;
      const { definition, canonicalId } = resolveExerciseDefinition(ex.name);
      const load = resolvePerformanceLoad(definition, ex.name, ex.weight, bodyweightKg);
      const isBodyweightLoad = load.loadMode === 'bodyweight' || load.loadMode === 'bodyweight_plus_external';
      if (load.loadMode === 'bodyweight') {
        // Reps/time benchmarks are scored directly on reps; no e1RM involved.
        pushPerformance({
          canonicalKey: canonicalId,
          name: definition?.name || ex.name.trim(),
          definition,
          timestamp: new Date(log.timestamp).getTime(),
          benchmarkLoad: reps,
          estimated1RM: reps,
          repRange: reps,
          estimate: { estimated1RM: reps, formula: 'actual', repConfidence: 'high', usableForStrength: true },
          suspectedOutlier: false,
          excludeFromScoring: false,
          source: 'logged_e1rm',
        });
        return;
      }
      const estimate = estimateOneRepMaxDetailed(load.benchmarkLoad, reps);
      // Absolute plausibility only here; the personal-jump screen runs in a
      // second pass so the verdict cannot depend on log iteration order.
      const plausibility = estimate.usableForStrength
        ? checkPlausibility(definition, load.benchmarkLoad, estimate.estimated1RM, [])
        : { plausible: false, suspectedOutlier: false, excludeFromScoring: true, reason: 'reps beyond benchmark range' };
      pushPerformance({
        canonicalKey: canonicalId,
        name: definition?.name || ex.name.trim(),
        definition,
        timestamp: new Date(log.timestamp).getTime(),
        benchmarkLoad: load.benchmarkLoad,
        estimated1RM: estimate.usableForStrength ? estimate.estimated1RM : 0,
        repRange: reps,
        estimate,
        suspectedOutlier: plausibility.suspectedOutlier,
        excludeFromScoring: plausibility.excludeFromScoring || !estimate.usableForStrength,
        source: 'logged_e1rm',
      });
    });
  };
  logs.forEach((log) => collectFromLog(log));

  // Personal-jump screen (order-independent): flag the top e1RM of an exercise
  // when it towers over the lifter's own second-best by >30% AND >20kg. The
  // entry stays countable — reviewable, not auto-deleted (spec #12).
  performancesByKey.forEach((candidates) => {
    const usable = candidates.filter((c) => !c.excludeFromScoring && c.estimated1RM > 0);
    if (usable.length < 2) return;
    const best = Math.max(...usable.map((c) => c.estimated1RM));
    const secondBest = Math.max(...usable.filter((c) => c.estimated1RM < best).map((c) => c.estimated1RM));
    if (best >= secondBest + 20 && best > secondBest * 1.3) {
      usable.forEach((c) => {
        if (c.estimated1RM === best) c.suspectedOutlier = true;
      });
    }
  });

  // Legacy profile PRs: lowest-priority fallback, only where logs have no data.
  const legacyByKey = new Map<string, PerformanceCandidate>();
  Object.entries(userPrs).forEach(([name, storedValue]) => {
    if (!Number.isFinite(storedValue)) return;
    const { definition, canonicalId } = resolveExerciseDefinition(name);
    if (!definition) return;
    if (performancesByKey.has(canonicalId)) return; // log data wins
    const load = resolvePerformanceLoad(definition, name, storedValue, bodyweightKg);
    if (load.loadMode === 'bodyweight') return; // legacy reps are not interpretable
    const benchmarkValue = load.effectiveTotalLoad > 0 ? load.effectiveTotalLoad : load.benchmarkLoad;
    if (benchmarkValue <= 0) return;
    legacyByKey.set(canonicalId, {
      canonicalKey: canonicalId,
      name: definition.name,
      definition,
      timestamp: 0,
      benchmarkLoad: benchmarkValue,
      estimated1RM: benchmarkValue,
      repRange: 1,
      estimate: { estimated1RM: benchmarkValue, formula: 'actual', repConfidence: 'low', usableForStrength: true },
      suspectedOutlier: false,
      excludeFromScoring: false,
      source: 'legacy_profile_pr',
    });
  });

  // Build per-exercise assessments (best usable performance per exercise).
  const categorizedPrs: CategorizedPrItem[] = [];
  const assessmentByExercise = new Map<string, { assessment: ExerciseStrengthAssessment; candidate: PerformanceCandidate }>();

  const assessCandidate = (candidate: PerformanceCandidate): ExerciseStrengthAssessment | null => {
    if (!candidate.definition || !candidate.definition.hasStrengthBenchmark) return null;
    if (!STRENGTH_BENCHMARKS[candidate.definition.id]) return null;
    if (candidate.excludeFromScoring) return null;
    if (candidate.estimated1RM <= 0) return null;
    const assessment = assessExerciseStrength(candidate.definition, {
      benchmarkValue: candidate.estimated1RM,
      repRange: candidate.repRange,
      repConfidence: candidate.estimate.repConfidence,
      estimateSpread: candidate.estimate.estimateSpread,
      formula: candidate.estimate.formula,
      source: candidate.source,
    }, resolvedBody);
    if (!assessment) return null;
    return { ...assessment, suspectedOutlier: candidate.suspectedOutlier };
  };

  performancesByKey.forEach((candidates, key) => {
    const usable = candidates.filter((c) => !c.excludeFromScoring && c.estimated1RM > 0);
    const best = usable.reduce<PerformanceCandidate | null>((acc, c) => (!acc || c.estimated1RM > acc.estimated1RM ? c : acc), null);
    const bestAssessment = best ? assessCandidate(best) : null;
    if (best && bestAssessment) {
      assessmentByExercise.set(key, { assessment: bestAssessment, candidate: best });
      const benchmark = STRENGTH_BENCHMARKS[best.definition!.id];
      categorizedPrs.push({
        name: best.name,
        category: best.definition!.primaryCategory,
        weight: Number(best.benchmarkLoad.toFixed(1)),
        unit: benchmark.unit,
        loadMode: best.definition!.loadMode,
        score: bestAssessment.score,
        estimated1RM: best.estimate.formula === 'actual' ? best.estimate.estimated1RM : best.estimate.estimated1RM,
        tier: bestAssessment.tier,
        nextMilestone: bestAssessment.nextMilestone
          ? {
              targetWeight: bestAssessment.nextMilestone.targetValue,
              deltaWeight: bestAssessment.nextMilestone.deltaValue,
              nextTier: bestAssessment.nextMilestone.nextTier,
            }
          : undefined,
        source: best.source,
        repRange: best.repRange,
        confidence: bestAssessment.confidence,
        confidenceScore: bestAssessment.confidenceScore,
        suspectedOutlier: bestAssessment.suspectedOutlier,
      });
    }
    // Implausible entries stay visible for review but never enter scores.
    const excluded = candidates.filter((c) => c.excludeFromScoring && c.estimated1RM > 0);
    excluded.forEach((c) => {
      // Clear the flag for the assessment call so we still get score/tier for
      // display; the PR entry re-marks it and stays out of category scoring.
      const assessment = assessCandidate({ ...c, excludeFromScoring: false });
      if (!assessment) return;
      const benchmark = STRENGTH_BENCHMARKS[c.definition!.id];
      categorizedPrs.push({
        name: c.name,
        category: c.definition!.primaryCategory,
        weight: Number(c.benchmarkLoad.toFixed(1)),
        unit: benchmark.unit,
        loadMode: c.definition!.loadMode,
        score: assessment.score,
        estimated1RM: c.estimated1RM,
        tier: assessment.tier,
        source: c.source,
        repRange: c.repRange,
        confidence: assessment.confidence,
        confidenceScore: assessment.confidenceScore,
        suspectedOutlier: true,
        excludeFromScoring: true,
      });
    });
  });

  legacyByKey.forEach((candidate) => {
    const assessment = assessCandidate(candidate);
    if (!assessment) return;
    assessmentByExercise.set(candidate.canonicalKey, { assessment, candidate });
    const benchmark = STRENGTH_BENCHMARKS[candidate.definition!.id];
    categorizedPrs.push({
      name: candidate.name,
      category: candidate.definition!.primaryCategory,
      weight: Number(candidate.benchmarkLoad.toFixed(1)),
      unit: benchmark.unit,
      loadMode: candidate.definition!.loadMode,
      score: assessment.score,
      estimated1RM: candidate.estimated1RM,
      tier: assessment.tier,
      nextMilestone: assessment.nextMilestone
        ? {
            targetWeight: assessment.nextMilestone.targetValue,
            deltaWeight: assessment.nextMilestone.deltaValue,
            nextTier: assessment.nextMilestone.nextTier,
          }
        : undefined,
      source: candidate.source,
      repRange: candidate.repRange,
      confidence: assessment.confidence,
      confidenceScore: assessment.confidenceScore,
    });
  });

  // Category strength: one assessment per exercise, aggregated by reliability.
  const candidatesByCategory = new Map<WorkoutCategory, ExerciseStrengthAssessment[]>();
  assessmentByExercise.forEach(({ assessment }) => {
    const definition = EXERCISE_DEFINITIONS.find((d) => d.id === assessment.exerciseId);
    const cat = definition?.primaryCategory;
    if (!cat || cat === WorkoutCategory.Cardio) return;
    const list = candidatesByCategory.get(cat) ?? [];
    list.push(assessment);
    candidatesByCategory.set(cat, list);
  });

  // Progression: per-exercise best CURRENT-period e1RM vs best BASELINE e1RM.
  // High-rep/implausible performances never enter; exercises without a baseline
  // simply get no ratio (neutral progression, low confidence).
  const progressionRatios = new Map<SubMuscleGroup, number | null>();
  {
    const ratioAccumulator = new Map<SubMuscleGroup, { weighted: number; weight: number }>();
    performancesByKey.forEach((candidates, key) => {
      const usable = candidates.filter((c) => !c.excludeFromScoring && c.estimated1RM > 0 && c.timestamp > 0);
      const currentBest = Math.max(0, ...usable.filter((c) => c.timestamp >= cutoffTime).map((c) => c.estimated1RM));
      const baselineBest = Math.max(0, ...usable.filter((c) => c.timestamp < cutoffTime).map((c) => c.estimated1RM));
      if (currentBest <= 0 || baselineBest <= 0) return;
      const ratio = currentBest / baselineBest;
      const definition = usable[0].definition;
      if (!definition) return;
      for (const [smStr, coefficient] of Object.entries(definition.stimulusCoefficients)) {
        const sm = smStr as SubMuscleGroup;
        const c = coefficient || 0;
        if (c <= 0) continue;
        const acc = ratioAccumulator.get(sm) ?? { weighted: 0, weight: 0 };
        acc.weighted += ratio * c;
        acc.weight += c;
        ratioAccumulator.set(sm, acc);
      }
    });
    ratioAccumulator.forEach((acc, sm) => {
      progressionRatios.set(sm, acc.weight > 0 ? acc.weighted / acc.weight : null);
    });
  }

  // ------------------------------------------------------------------
  // Category details
  // ------------------------------------------------------------------
  const weeksInPeriod = Math.max(1, safeDays / 7);
  const categoryDetails: Record<WorkoutCategory, CategoryScoreDetail> = {} as Record<WorkoutCategory, CategoryScoreDetail>;
  const radarData: RadarDataPoint[] = [];
  const totalSetsAll = Object.values(categorySets).reduce((a, b) => a + b, 0);

  (Object.values(WorkoutCategory) as WorkoutCategory[]).forEach((cat) => {
    const meta = CATEGORY_META[cat];
    const sets = Math.round(categorySets[cat]);
    const workouts = categoryWorkoutOccurrences[cat];

    if (cat === WorkoutCategory.Cardio) {
      const cardioTier = getCardioTier(cardioSummary.score);
      categoryDetails[cat] = {
        category: cat,
        zh: meta.zh,
        en: meta.en,
        trainingScore: cardioSummary.score,
        cardioScore: cardioSummary.score,
        // Cardio is not a strength dimension and must never display as one.
        strengthScore: 0,
        activityScore: cardioSummary.frequencyScore,
        compositeScore: cardioSummary.score,
        tier: cardioTier,
        recentSets: cardioSummary.validSessions,
        totalVolumeKg: 0,
        bestExerciseName: cardioSummary.bestActivityName,
        bestRecordValue: cardioSummary.effectiveMinutes,
        bestRecordText: cardioSummary.effectiveMinutes > 0 ? `${cardioSummary.effectiveMinutes} min` : undefined,
        frequencyScore: cardioSummary.frequencyScore,
        volumeScore: cardioSummary.volumeScore,
        progressionScore: 0,
        consistencyScore: cardioSummary.consistencyScore,
        weeklyWorkouts: Number(cardioSummary.weeklySessions.toFixed(1)),
        cardioCalories: {
          actual: cardioSummary.calories,
          target: cardioSummary.calorieTarget,
          completionRate: cardioSummary.calorieCompletionRate,
          reported: cardioSummary.reportedCalories,
          estimated: cardioSummary.estimatedCalories,
        },
        cardioMetrics: cardioSummary,
      };
      radarData.push({
        subject: meta.zh,
        category: cat,
        composite: cardioSummary.score,
        strength: 0,
        activity: cardioSummary.frequencyScore,
        fullMark: 100,
      });
      return;
    }

    // Training capacity (V3, four dimensions).
    const capacity = computeTrainingCapacity(
      SUB_MUSCLE_WEIGHTS[cat] || {},
      currentStats,
      progressionRatios,
      safeDays
    );

    const subMuscleList = CATEGORY_SUB_MUSCLES[cat] || [];
    const weightsMap = SUB_MUSCLE_WEIGHTS[cat] || {};
    const subMuscleScoreDetails: SubMuscleScoreDetail[] = capacity.subMuscleDetails.map((detail) => {
      const smMeta = SUB_MUSCLE_META[detail.subMuscle];
      return {
        subMuscle: detail.subMuscle,
        zh: smMeta.zh,
        en: smMeta.en,
        weight: weightsMap[detail.subMuscle] ?? (1 / Math.max(1, subMuscleList.length)),
        score: detail.score,
        frequencyScore: detail.frequencyScore,
        volumeScore: detail.volumeScore,
        progressionScore: detail.progressionScore,
        consistencyScore: detail.consistencyScore,
        weeklyFrequency: detail.weeklyFrequency,
        weeklyEffectiveSets: detail.weeklyEffectiveSets,
        targetSets: {
          min: detail.target.minEffectiveSets,
          target: detail.target.targetEffectiveSets,
          upper: detail.target.upperUsefulSets,
        },
        hasProgressionBaseline: detail.hasProgressionBaseline,
      };
    });

    const trainingScore = capacity.hasData ? capacity.score : 0;
    const tier = getTrainingStateTier(trainingScore);

    // Strength assessment for this category.
    const strengthCandidates = candidatesByCategory.get(cat) ?? [];
    const strengthAssessment = aggregateCategoryStrength(strengthCandidates, resolvedBody);
    const bestEvidence = strengthAssessment
      ? [...strengthAssessment.primaryEvidence, ...strengthAssessment.secondaryEvidence][0]
      : undefined;

    categoryDetails[cat] = {
      category: cat,
      zh: meta.zh,
      en: meta.en,
      trainingScore,
      compositeScore: trainingScore,
      tier,
      strengthScore: strengthAssessment?.score ?? 0,
      strengthAssessment,
      activityScore: capacity.frequencyScore,
      frequencyScore: capacity.frequencyScore,
      volumeScore: capacity.volumeScore,
      progressionScore: capacity.progressionScore,
      consistencyScore: capacity.consistencyScore,
      weeklyWorkouts: Number((workouts / weeksInPeriod).toFixed(1)),
      recentSets: sets,
      totalVolumeKg: Math.round(categoryTonnage[cat]),
      bestExerciseName: bestEvidence?.exerciseName,
      bestRecordValue: bestEvidence
        ? Number(bestEvidence.assessment.benchmarkValue.toFixed(1))
        : undefined,
      bestRecordText: bestEvidence
        ? `${Number(bestEvidence.assessment.benchmarkValue.toFixed(1))} ${bestEvidence.assessment.unit === 'kg' ? 'KG' : bestEvidence.assessment.unit === 'sec' ? 'S' : 'REPS'}`
        : undefined,
      subMuscleScores: subMuscleScoreDetails,
      strengthConfidence: strengthAssessment?.confidence,
    };

    radarData.push({
      subject: meta.zh,
      category: cat,
      composite: trainingScore,
      strength: strengthAssessment?.score ?? 0,
      activity: capacity.frequencyScore,
      fullMark: 100,
    });
  });

  // ------------------------------------------------------------------
  // Volume distribution
  // ------------------------------------------------------------------
  const volumeDistribution: VolumeDistributionItem[] = (Object.values(WorkoutCategory) as WorkoutCategory[]).map((cat) => {
    const meta = CATEGORY_META[cat];
    const sets = Math.round(categorySets[cat]);
    const percentage = totalSetsAll > 0 ? Math.round((sets / totalSetsAll) * 100) : 0;
    return {
      category: cat,
      zh: meta.zh,
      color: meta.color,
      hex: meta.hex,
      sets,
      percentage,
      workoutCount: categoryWorkoutOccurrences[cat],
    };
  });

  // ------------------------------------------------------------------
  // Insights: resistance balance, cardio separate, eligibility-gated lagging
  // ------------------------------------------------------------------
  const resistanceCategories = (Object.values(WorkoutCategory) as WorkoutCategory[]).filter((c) => c !== WorkoutCategory.Cardio);
  const resistanceScores = resistanceCategories.map((c) => categoryDetails[c].trainingScore);
  const activeResistance = resistanceCategories.filter((c) => categoryDetails[c].trainingScore > 0);
  const maxResistanceScore = Math.max(...resistanceScores, 0);
  const activeScores = activeResistance.map((c) => categoryDetails[c].trainingScore);
  const avgScore = activeScores.length > 0 ? activeScores.reduce((a, b) => a + b, 0) / activeScores.length : 0;
  const stdDev = activeScores.length > 0
    ? Math.sqrt(activeScores.reduce((acc, val) => acc + Math.pow(val - avgScore, 2), 0) / activeScores.length)
    : 0;

  let balanceScore = 100;
  let balanceLevel: WorkoutInsights['balanceLevel'] = '极度均衡';
  if (maxResistanceScore === 0) {
    balanceScore = 0;
    balanceLevel = '蓄势起步';
  } else {
    balanceScore = Math.max(20, Math.min(100, Math.round(100 - stdDev * 1.5)));
    if (balanceScore >= 85) balanceLevel = '极度均衡';
    else if (balanceScore >= 70) balanceLevel = '均衡良好';
    else if (balanceScore >= 50) balanceLevel = '局部偏强';
    else balanceLevel = '偏科明显';
  }

  // Dominant: highest score among categories with real evidence.
  const MIN_EVIDENCE_SETS = 3;
  const evidenceFor = (cat: WorkoutCategory): number => {
    const detail = categoryDetails[cat];
    const muscleSets = (detail.subMuscleScores ?? []).reduce((sum, sm) => sum + sm.weeklyEffectiveSets * weeksInPeriod, 0);
    return Math.max(detail.recentSets, Math.round(muscleSets));
  };

  const eligibleDominant = [...activeResistance]
    .filter((c) => evidenceFor(c) >= MIN_EVIDENCE_SETS)
    .sort((a, b) => categoryDetails[b].trainingScore - categoryDetails[a].trainingScore)[0];
  const dominant = eligibleDominant ?? (activeResistance.length > 0 ? activeResistance.sort((a, b) => categoryDetails[b].trainingScore - categoryDetails[a].trainingScore)[0] : undefined);

  // Lagging: three states (not trained / insufficient data / actually lagging).
  let lagging: WorkoutCategory | undefined;
  let laggingStatus: LaggingStatus = 'none';
  {
    const untrained = resistanceCategories.filter((c) => categoryDetails[c].trainingScore === 0);
    const trained = activeResistance.filter((c) => evidenceFor(c) >= MIN_EVIDENCE_SETS);
    if (recentLogs.length >= 3 && trained.length > 0) {
      if (untrained.length > 0) {
        lagging = untrained.sort((a, b) => evidenceFor(b) - evidenceFor(a))[0];
        laggingStatus = 'not_trained';
      } else {
        const lowest = trained.sort((a, b) => categoryDetails[a].trainingScore - categoryDetails[b].trainingScore)[0];
        if (lowest && categoryDetails[lowest].trainingScore < (dominant ? categoryDetails[dominant].trainingScore : 50) - 20) {
          lagging = lowest;
          laggingStatus = 'lagging';
        }
      }
    } else if (recentLogs.length > 0) {
      const candidate = untrained[0] ?? trained.sort((a, b) => categoryDetails[a].trainingScore - categoryDetails[b].trainingScore)[0];
      if (candidate) {
        lagging = candidate;
        laggingStatus = 'insufficient_data';
      }
    }
  }

  const highlights: string[] = [];
  const recommendations: string[] = [];

  if (dominant && categoryDetails[dominant].trainingScore >= 40) {
    highlights.push(
      `优势部位：${categoryDetails[dominant].zh} (${categoryDetails[dominant].trainingScore}分 · ${categoryDetails[dominant].tier.zh})，近期训练频率与有效容量充足。`
    );
  } else if (recentLogs.length > 0) {
    highlights.push(`训练状态记录中，近 ${safeDays} 天累计完成 ${recentLogs.length} 次训练打卡！`);
  } else {
    highlights.push('记录你的第一次训练，即可激活六维健身能力图谱！');
  }

  if (lagging && laggingStatus === 'lagging') {
    recommendations.push(
      `薄弱提醒：${categoryDetails[lagging].zh} (${categoryDetails[lagging].trainingScore}分) 相对滞后，建议增加针对性训练，提升全身均衡发展。`
    );
  } else if (lagging && laggingStatus === 'not_trained') {
    recommendations.push(
      `均衡提醒：近 ${safeDays} 天几乎没有训练${categoryDetails[lagging].zh}，建议每周安排 1-2 次针对性训练。`
    );
  }

  if (categorySets[WorkoutCategory.Legs] === 0 && recentLogs.length >= 3) {
    recommendations.push('提示：近期下肢腿部训练较少，适度深蹲与硬拉可强化核心及下肢力量！');
  } else if (categorySets[WorkoutCategory.Cardio] === 0 && recentLogs.length >= 4) {
    recommendations.push('心肺建议：每周穿插 1-2 次有氧或 HIIT，有助于提升心肺体能与代谢恢复。');
  }

  if (recommendations.length === 0) {
    recommendations.push('各部位训练频率与有效容量发展均衡，请继续保持当前的训练节奏与渐进超负荷！');
  }

  return {
    categoryDetails,
    radarData,
    volumeDistribution,
    insights: {
      balanceScore,
      balanceLevel,
      dominantCategory: dominant,
      laggingCategory: lagging,
      laggingStatus,
      dominantScore: dominant ? categoryDetails[dominant].trainingScore : 0,
      laggingScore: lagging ? categoryDetails[lagging].trainingScore : 0,
      highlights,
      recommendations,
    },
    categorizedPrs: categorizedPrs.sort((a, b) => b.score - a.score),
    recentWorkoutsCount: recentLogs.length,
    recentSetsCount: Math.round(totalSetsAll),
  };
}

function zeroCategories(): Record<WorkoutCategory, number> {
  return {
    [WorkoutCategory.Chest]: 0,
    [WorkoutCategory.Back]: 0,
    [WorkoutCategory.Legs]: 0,
    [WorkoutCategory.Shoulders]: 0,
    [WorkoutCategory.Others]: 0,
    [WorkoutCategory.Cardio]: 0,
  };
}
