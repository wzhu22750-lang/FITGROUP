const r=e=>Number.isFinite(e)&&e>0?e:0;function g(e=[]){return e.reduce((t,n)=>(t.actions+=1,n.type==="strength"?t.sets+=r(n.sets):n.type==="cardio"&&(t.cardioMinutes+=r(n.duration),t.distance+=r(n.distance)),t),{actions:0,sets:0,cardioMinutes:0,distance:0})}function u(e,t=new Date){return Array.from({length:7},(d,o)=>{const i=new Date(t);i.setHours(0,0,0,0),i.setDate(i.getDate()-(6-o));const s=new Date(i);return s.setDate(s.getDate()+1),{date:i,count:e.filter(c=>{const a=new Date(c.timestamp).getTime();return a>=i.getTime()&&a<s.getTime()&&a<=t.getTime()}).length}})}export{u as r,g as s};
