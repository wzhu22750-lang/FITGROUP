rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth uid
    // Fields:
    //   - displayName: string (required, 1-50) — public nickname
    //   - photoURL: string (required, 0-500, empty or http(s))
    //   - streak: number (required, 0-100000)
    //   - totalWorkouts: number (required, 0-1000000)
    //   - lastWorkoutDate: timestamp (optional)
    //   - prs: map (required, <= 50 keys) — exercise name -> weight
    // Notes: email/phone stay in Firebase Auth only. No role fields.
    //
    // Collection: workoutLogs
    // Document ID: client-generated [a-zA-Z0-9_-] <= 128
    // Fields:
    //   - userId: string (required, immutable, == auth.uid)
    //   - userName: string (required, 1-50)
    //   - userPhoto: string (required, 0-500, empty or http(s))
    //   - timestamp: timestamp (required, server time on create)
    //   - category: string enum Shoulders|Chest|Back|Legs|Cardio|Others
    //   - exercises: list (required, 1-50 maps)
    //   - note: string (required, 0-500)
    //   - photoUrl: string (required, 0-500, empty or http(s))
    //   - likesCount: number (required, 0-1000000)
    //   - commentsCount: number (required, 0-1000000)
    //
    // Subcollection: workoutLogs/{logId}/likes
    // Document ID: auth.uid
    // Fields:
    //   - userId: string (required, == auth.uid, immutable)
    //
    // Subcollection: workoutLogs/{logId}/comments
    // Document ID: client-generated [a-zA-Z0-9_-] <= 128
    // Fields:
    //   - userId: string (required, == auth.uid, immutable)
    //   - userName: string (required, 1-50)
    //   - userPhoto: string (required, 0-500, empty or http(s))
    //   - content: string (required, 1-300)
    //   - timestamp: timestamp (required, server time on create)
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmptyOrHttpUrl(value) {
      return value is string && value.size() <= 500
        && (value.size() == 0
          || value.matches('^https://.*')
          || value.matches('^http://.*'));
    }

    function isNonNegInt(value, maxVal) {
      return value is number && value >= 0 && value <= maxVal;
    }

    function isRecentTimestamp(value) {
      return value is timestamp
        && value <= request.time
        && value > request.time - duration.value(5, 'm');
    }

    function uidUnchanged() {
      return !('uid' in incoming()) || incoming().uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in incoming()) || incoming().uid == existing().uid;
    }

    function isValidExercise(ex) {
      return ex is map
        && ex.keys().hasOnly(['id', 'name', 'type', 'weight', 'sets', 'reps', 'duration', 'distance', 'calories'])
        && ex.id is string && ex.id.size() > 0 && ex.id.size() <= 64
        && ex.name is string && ex.name.size() > 0 && ex.name.size() <= 80
        && ex.type in ['strength', 'cardio']
        && (
          (ex.type == 'strength'
            && (!('weight' in ex) || (ex.weight is number && ex.weight >= 0 && ex.weight <= 2000))
            && (!('sets' in ex) || (ex.sets is number && ex.sets >= 0 && ex.sets <= 100))
            && (!('reps' in ex) || (ex.reps is number && ex.reps >= 0 && ex.reps <= 1000)))
          ||
          (ex.type == 'cardio'
            && (!('duration' in ex) || (ex.duration is number && ex.duration >= 0 && ex.duration <= 1440))
            && (!('distance' in ex) || (ex.distance is number && ex.distance >= 0 && ex.distance <= 1000))
            && (!('calories' in ex) || (ex.calories is number && ex.calories >= 0 && ex.calories <= 20000)))
        );
    }

    function isValidExercises(list) {
      return list is list && list.size() >= 1 && list.size() <= 10
        && (list.size() < 1 || isValidExercise(list[0]))
        && (list.size() < 2 || isValidExercise(list[1]))
        && (list.size() < 3 || isValidExercise(list[2]))
        && (list.size() < 4 || isValidExercise(list[3]))
        && (list.size() < 5 || isValidExercise(list[4]))
        && (list.size() < 6 || isValidExercise(list[5]))
        && (list.size() < 7 || isValidExercise(list[6]))
        && (list.size() < 8 || isValidExercise(list[7]))
        && (list.size() < 9 || isValidExercise(list[8]))
        && (list.size() < 10 || isValidExercise(list[9]));
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['displayName', 'photoURL', 'streak', 'totalWorkouts', 'lastWorkoutDate', 'prs'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50
        && isEmptyOrHttpUrl(data.photoURL)
        && isNonNegInt(data.streak, 100000)
        && isNonNegInt(data.totalWorkouts, 1000000)
        && data.prs is map && data.prs.size() <= 50
        && (!('lastWorkoutDate' in data) || data.lastWorkoutDate is timestamp);
    }

    function isValidLog(data) {
      return data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'timestamp', 'category', 'exercises', 'note', 'photoUrl', 'likesCount', 'commentsCount'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 50
        && isEmptyOrHttpUrl(data.userPhoto)
        && data.timestamp is timestamp
        && data.category in ['Shoulders', 'Chest', 'Back', 'Legs', 'Cardio', 'Others']
        && isValidExercises(data.exercises)
        && data.note is string && data.note.size() <= 500
        && isEmptyOrHttpUrl(data.photoUrl)
        && isNonNegInt(data.likesCount, 1000000)
        && isNonNegInt(data.commentsCount, 1000000);
    }

    function isValidLike(data) {
      return data.keys().hasOnly(['userId'])
        && data.userId == request.auth.uid;
    }

    function isValidComment(data) {
      return data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'content', 'timestamp'])
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 50
        && isEmptyOrHttpUrl(data.userPhoto)
        && data.content is string && data.content.size() > 0 && data.content.size() <= 300
        && data.timestamp is timestamp;
    }

    function logIdentityUnchanged() {
      return incoming().userId == existing().userId
        && incoming().userName == existing().userName
        && incoming().userPhoto == existing().userPhoto
        && incoming().category == existing().category
        && incoming().note == existing().note
        && incoming().photoUrl == existing().photoUrl
        && incoming().exercises == existing().exercises;
    }

    function isValidLikeCounterUpdate(logId) {
      return logIdentityUnchanged()
        && incoming().keys().hasOnly(['userId', 'userName', 'userPhoto', 'timestamp', 'category', 'exercises', 'note', 'photoUrl', 'likesCount', 'commentsCount'])
        && incoming().commentsCount == existing().commentsCount
        && isNonNegInt(incoming().likesCount, 1000000)
        && math.abs(incoming().likesCount - existing().likesCount) == 1
        && (
          (incoming().likesCount == existing().likesCount + 1
            && !exists(/databases/$(database)/documents/workoutLogs/$(logId)/likes/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/workoutLogs/$(logId)/likes/$(request.auth.uid)) != null)
          ||
          (incoming().likesCount == existing().likesCount - 1
            && exists(/databases/$(database)/documents/workoutLogs/$(logId)/likes/$(request.auth.uid))
            && getAfter(/databases/$(database)/documents/workoutLogs/$(logId)/likes/$(request.auth.uid)) == null)
        );
    }

    function isValidCommentCounterUpdate() {
      return logIdentityUnchanged()
        && incoming().keys().hasOnly(['userId', 'userName', 'userPhoto', 'timestamp', 'category', 'exercises', 'note', 'photoUrl', 'likesCount', 'commentsCount'])
        && incoming().likesCount == existing().likesCount
        && isNonNegInt(incoming().commentsCount, 1000000)
        && incoming().commentsCount == existing().commentsCount + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(incoming()) && uidUnchanged();
      allow update: if isOwner(userId) && isValidUser(incoming()) && uidNotModified();
      allow delete: if false;
    }

    match /workoutLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && isValidId(logId)
        && isValidLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().likesCount == 0
        && incoming().commentsCount == 0
        && isRecentTimestamp(incoming().timestamp);
      allow update: if isAuthenticated() && (
        (isOwner(existing().userId)
          && isValidLog(incoming())
          && incoming().userId == existing().userId
          && incoming().timestamp == existing().timestamp
          && incoming().likesCount == existing().likesCount
          && incoming().commentsCount == existing().commentsCount
          && incoming().diff(existing()).affectedKeys()
            .hasOnly(['category', 'exercises', 'note', 'photoUrl', 'userName', 'userPhoto']))
        || isValidLikeCounterUpdate(logId)
        || isValidCommentCounterUpdate()
      );
      allow delete: if isOwner(existing().userId);

      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && exists(/databases/$(database)/documents/workoutLogs/$(logId))
          && likeId == request.auth.uid
          && isValidLike(incoming());
        allow update: if false;
        allow delete: if isOwner(existing().userId);
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && exists(/databases/$(database)/documents/workoutLogs/$(logId))
          && isValidId(commentId)
          && isValidComment(incoming())
          && isRecentTimestamp(incoming().timestamp);
        allow update: if false;
        allow delete: if isOwner(existing().userId);
      }
    }
  }
}
