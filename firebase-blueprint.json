{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and aggregate stats",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" },
        "streak": { "type": "number", "description": "Current consecutive workout days" },
        "lastWorkoutDate": { "type": "string", "format": "date-time" },
        "totalWorkouts": { "type": "number" },
        "prs": { "type": "object", "description": "Personal records for exercises" }
      },
      "required": ["displayName", "email"]
    },
    "WorkoutLog": {
      "title": "Workout Log",
      "description": "A single workout session entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "category": { "type": "string", "enum": ["Shoulders", "Chest", "Back", "Legs", "Cardio", "Others"] },
        "exercises": { "type": "array" },
        "photoUrl": { "type": "string" },
        "note": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" }
      },
      "required": ["userId", "timestamp", "category"]
    },
    "Like": {
      "title": "Log Like",
      "description": "Social interaction on a workout log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "logId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "logId"]
    },
    "Comment": {
      "title": "Log Comment",
      "description": "User comment on a workout log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "workoutLogs/{logId}": {
      "schema": "WorkoutLog",
      "description": "Daily fitness records"
    },
    "workoutLogs/{logId}/likes/{likeId}": {
      "schema": "Like",
      "description": "Likes on workout logs"
    },
    "workoutLogs/{logId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on workout logs"
    }
  }
}
