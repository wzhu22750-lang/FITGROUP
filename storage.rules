rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /u/{userId}/a/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isImageUnder(5 * 1024 * 1024);
    }

    match /u/{userId}/w/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isImageUnder(8 * 1024 * 1024);
    }
  }
}
